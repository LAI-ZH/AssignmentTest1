@{
    ViewData["Title"] = "Trainer Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/TrainerDashboard.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- 你的 HTML 内容 --> 
<div class="db-root">
    <div class="db-header">
        <h1><i class="fas fa-user-tie me-2"></i>Trainer Dashboard</h1>
        <span class="db-welcome">Welcome back, <strong>@User.Identity.Name</strong></span>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card success">
            <i class="fas fa-dumbbell stat-icon"></i>
            <div class="stat-label">My Classes</div>
            <div class="stat-num">@(ViewBag.MyClasses?.Count ?? 0)</div>
        </div>
        <div class="stat-card warning">
            <i class="fas fa-users stat-icon"></i>
            <div class="stat-label">Total Students</div>
            <div class="stat-num">@ViewBag.TotalStudents</div>
        </div>
        <div class="stat-card info">
            <i class="fas fa-calendar-check stat-icon"></i>
            <div class="stat-label">Upcoming Classes</div>
            <div class="stat-num">@(ViewBag.UpcomingSchedules?.Count ?? 0)</div>
        </div>
    </div>

    <!-- ✅ Schedule Calendar -->
    <div class="mt-4">
        <h5><i class="fas fa-calendar-alt me-2"></i>My Class Schedule</h5>
        <p class="text-muted small">Showing only classes assigned to you</p>
        @{
            var mySchedules = ViewBag.MySchedules as IEnumerable<AssignmentTest1.Models.Entities.ClassSchedule> ?? new List<AssignmentTest1.Models.Entities.ClassSchedule>();
            await Html.RenderPartialAsync("_ScheduleCalendar", mySchedules);
        }
    </div>

    <!-- My Classes -->
    <div class="db-section mt-4">
        <p class="section-title"><i class="fas fa-list me-1"></i>My Classes</p>
        <div class="class-grid">
            @if (ViewBag.MyClasses != null && ViewBag.MyClasses.Count > 0)
            {
                @foreach (var classItem in ViewBag.MyClasses)
                {
                    <div class="class-card">
                        <h5>@classItem.ClassName</h5>
                        <p class="class-meta"><i class="fas fa-tag me-1"></i>@classItem.Category</p>
                        <p class="class-meta"><i class="fas fa-users me-1"></i>Max: @classItem.MaxCapacity</p>
                        <p class="class-meta"><i class="fas fa-calendar me-1"></i>@(classItem.Schedules?.Count ?? 0) schedules</p>
                    </div>
                }
            }
            else
            {
                <p class="db-empty" style="grid-column: span 3;">You have no classes assigned yet.</p>
            }
        </div>
    </div>

</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}