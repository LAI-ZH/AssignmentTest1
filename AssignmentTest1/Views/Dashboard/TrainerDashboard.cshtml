@{
    ViewData["Title"] = "Trainer Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/TrainerDashboard.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- 你的 HTML 内容 --> 
<div class="db-root">
    <div class="db-header">
        <h1><i class="fas fa-user-tie me-2"></i>Trainer Dashboard</h1>
        <span class="db-welcome">Welcome back, <strong>@User.Identity.Name</strong></span>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card success">
            <i class="fas fa-dumbbell stat-icon"></i>
            <div class="stat-label">My Classes</div>
            <div class="stat-num">@(ViewBag.MyClasses?.Count ?? 0)</div>
        </div>
        <div class="stat-card warning">
            <i class="fas fa-users stat-icon"></i>
            <div class="stat-label">Total Students</div>
            <div class="stat-num">@ViewBag.TotalStudents</div>
        </div>
        <div class="stat-card info">
            <i class="fas fa-calendar-check stat-icon"></i>
            <div class="stat-label">Upcoming Classes</div>
            <div class="stat-num">@(ViewBag.UpcomingSchedules?.Count ?? 0)</div>
        </div>
    </div>

    <!-- ✅ Schedule Calendar -->
    <div class="mt-4">
        <h5><i class="fas fa-calendar-alt me-2"></i>My Class Schedule</h5>
        <p class="text-muted small">Showing only classes assigned to you</p>
        @{
            var mySchedules = ViewBag.MySchedules as IEnumerable<AssignmentTest1.Models.Entities.ClassSchedule> ?? new List<AssignmentTest1.Models.Entities.ClassSchedule>();
            await Html.RenderPartialAsync("_ScheduleCalendar", mySchedules);
        }
    </div>

    <!-- My Classes -->
    <div class="db-section mt-4">
        <p class="section-title"><i class="fas fa-list me-1"></i>My Classes</p>
        <div class="class-grid">
            @if (ViewBag.MyClasses != null && ViewBag.MyClasses.Count > 0)
            {
                @foreach (var classItem in ViewBag.MyClasses)
                {
                    <div class="class-card">
                        <h5>@classItem.ClassName</h5>
                        <p class="class-meta"><i class="fas fa-tag me-1"></i>@classItem.Category</p>
                        <p class="class-meta"><i class="fas fa-users me-1"></i>Max: @classItem.MaxCapacity</p>
                        <p class="class-meta"><i class="fas fa-calendar me-1"></i>@(classItem.Schedules?.Count ?? 0) schedules</p>
                    </div>
                }
            }
            else
            {
                <p class="db-empty" style="grid-column: span 3;">You have no classes assigned yet.</p>
            }
        </div>
    </div>

    <!-- Private Session Requests -->
<div class="db-section mt-4">
    <p class="section-title">
        <i class="fas fa-user-tie me-1"></i>Private Session Requests
        @if (ViewBag.PendingPrivateSessions > 0)
        {
            <span class="badge bg-warning text-dark ms-2">@ViewBag.PendingPrivateSessions pending</span>
        }
    </p>
    <div class="db-card">
        @if (ViewBag.PrivateSessions != null && ViewBag.PrivateSessions.Count > 0)
        {
            <table class="db-table">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Preferred Date</th>
                        <th>Preferred Time</th>
                        <th>Notes</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in ViewBag.PrivateSessions)
                    {
                        <tr>
                            <td>@session.Member?.FullName</td>
                            <td>@session.PreferredDate.ToString("dd/MM/yyyy")</td>
                            <td>@session.PreferredTime</td>
                            <td>@(string.IsNullOrEmpty(session.Notes) ? "-" : session.Notes)</td>
                            <td>
                                @if (session.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (session.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                }
                                else if (session.Status == "Completed")
                                {
                                    <span class="badge bg-primary">Completed</span>
                                }
                                else if (session.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                            </td>
                            <td>
                                @if (session.Status == "Pending")
                                {
                                    <form asp-controller="Trainer" asp-action="ConfirmPrivateSession" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sessionId" value="@session.PrivateSessionId" />
                                        <button type="submit" class="btn btn-sm btn-success">Confirm</button>
                                    </form>
                                    <form asp-controller="Trainer" asp-action="RejectPrivateSession" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sessionId" value="@session.PrivateSessionId" />
                                        <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                    </form>
                                }
                                @if (session.Status == "Confirmed")
                                {
                                    <form asp-controller="Trainer" asp-action="CompletePrivateSession" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sessionId" value="@session.PrivateSessionId" />
                                        <button type="submit" class="btn btn-sm btn-primary">Mark Complete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="db-empty">No private session requests.</p>
        }
    </div>
</div>

</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}