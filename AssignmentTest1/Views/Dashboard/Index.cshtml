@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;  // ✅ 独立设计，不使用默认 Layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/AdminDash.css" />
</head>
<body>

    <div class="dashboard-container">

        <!-- ===== SIDEBAR ===== -->
        <nav class="sidebar">
            <div class="sidebar-logo">💪</div>
            <ul class="sidebar-menu">
                <li><a href="@Url.Action("Index", "Dashboard")" class="active"><i class="fas fa-chart-pie"></i><span>Dashboard</span></a></li>
                <li><a href="@Url.Action("Index", "User")"><i class="fas fa-users"></i><span>Users</span></a></li>
                <li><a href="@Url.Action("Index", "Trainer")"><i class="fas fa-user-tie"></i><span>Trainers</span></a></li>
                <li><a href="@Url.Action("Index", "Class")"><i class="fas fa-dumbbell"></i><span>Classes</span></a></li>
                <li><a href="@Url.Action("Index", "Schedule")"><i class="fas fa-calendar-alt"></i><span>Schedules</span></a></li>
                <li><a href="@Url.Action("Plans", "Membership")"><i class="fas fa-crown"></i><span>Memberships</span></a></li>
                <li><a href="@Url.Action("AdminIndex", "Booking")"><i class="fas fa-calendar-check"></i><span>Bookings</span></a></li>
                <li style="margin-top:20px;">
                    <a asp-controller="Account" asp-action="Logout" method="post" style="color:#f07a7a;">
                        <i class="fas fa-sign-out-alt"></i><span>Logout</span>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- ===== MAIN CONTENT ===== -->
        <main class="main-content">

            <!-- Header -->
            <header class="dashboard-header">
                <div class="dashboard-title">
                    <i class="fas fa-chart-pie"></i>
                    <h1>Dashboard</h1>
                </div>
                <div class="welcome-badge">
                    <i class="fas fa-user-circle"></i> @User.Identity.Name
                </div>
            </header>

            <!-- Stats Row 1 -->
            <div class="stats-grid">
                <div class="stat-card admin-card">
                    <h3><i class="fas fa-user-shield" style="margin-right:6px;"></i> Admins</h3>
                    <div class="number">@ViewBag.TotalAdmins</div>
                    <div class="icon"><i class="fas fa-user-shield"></i></div>
                </div>
                <div class="stat-card trainer-card">
                    <h3><i class="fas fa-user-tie" style="margin-right:6px;"></i> Trainers</h3>
                    <div class="number">@ViewBag.TotalTrainers</div>
                    <div class="icon"><i class="fas fa-user-tie"></i></div>
                </div>
                <div class="stat-card member-card">
                    <h3><i class="fas fa-user" style="margin-right:6px;"></i> Members</h3>
                    <div class="number">@ViewBag.TotalMembers</div>
                    <div class="icon"><i class="fas fa-user"></i></div>
                </div>
            </div>

            <!-- Stats Row 2 -->
            <div class="stats-grid-secondary">
                <div class="stat-card class-card">
                    <h3><i class="fas fa-dumbbell" style="margin-right:6px;"></i> Total Classes</h3>
                    <div class="number">@ViewBag.TotalClasses</div>
                    <div class="icon"><i class="fas fa-dumbbell"></i></div>
                </div>
                <div class="stat-card booking-card">
                    <h3><i class="fas fa-calendar-check" style="margin-right:6px;"></i> Total Bookings</h3>
                    <div class="number">@ViewBag.TotalBookings</div>
                    <div class="icon"><i class="fas fa-calendar-check"></i></div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="quick-actions">
                <div class="quick-actions-title">
                    <i class="fas fa-bolt" style="color:#536cf5;"></i>
                    <h2>Quick Actions</h2>
                </div>
                <div class="quick-actions-grid">
                    <a href="@Url.Action("Index", "User")" class="quick-action"><i class="fas fa-users"></i> Manage Users</a>
                    <a href="@Url.Action("Index", "Class")" class="quick-action green"><i class="fas fa-dumbbell"></i> Manage Classes</a>
                    <a href="@Url.Action("Index", "Schedule")" class="quick-action orange"><i class="fas fa-calendar-alt"></i> Manage Schedules</a>
                    <a href="@Url.Action("Plans", "Membership")" class="quick-action blue"><i class="fas fa-crown"></i> Memberships</a>
                    <a href="@Url.Action("AdminIndex", "Booking")" class="quick-action green"><i class="fas fa-calendar-check"></i> Bookings</a>
                    <a href="@Url.Action("Index", "Trainer")" class="quick-action orange"><i class="fas fa-user-tie"></i> Trainers</a>
                </div>
            </div>

            <!-- Analytics / Charts -->
            <div class="analytics-grid">
                <div class="dashboard-card">
                    <div class="card-header">
                        <h2><i class="fas fa-users" style="color:#536cf5;"></i> User Roles</h2>
                    </div>
                    <div class="user-roles">
                        <div class="role-item">
                            <div class="role-info">
                                <span class="role-dot" style="background:#ed5a42;"></span>
                                Admin
                            </div>
                            <span class="role-percentage">@ViewBag.TotalAdmins</span>
                        </div>
                        <div class="role-item">
                            <div class="role-info">
                                <span class="role-dot" style="background:#63c8d4;"></span>
                                Trainer
                            </div>
                            <span class="role-percentage">@ViewBag.TotalTrainers</span>
                        </div>
                        <div class="role-item">
                            <div class="role-info">
                                <span class="role-dot" style="background:#55b58b;"></span>
                                Member
                            </div>
                            <span class="role-percentage">@ViewBag.TotalMembers</span>
                        </div>
                        <div class="total-users">
                            <span>Total Users</span>
                            <span>@(ViewBag.TotalAdmins + ViewBag.TotalTrainers + ViewBag.TotalMembers)</span>
                        </div>
                    </div>
                </div>

                <div class="dashboard-card">
                    <div class="card-header">
                        <h2><i class="fas fa-chart-bar" style="color:#536cf5;"></i> Monthly Bookings</h2>
                    </div>
                    <div class="chart-container">
                        <canvas id="monthlyBookingChart" height="250"></canvas>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:24px;">
                <div class="dashboard-card">
                    <div class="card-header">
                        <h2><i class="fas fa-clock" style="color:#536cf5;"></i> Recent Bookings</h2>
                    </div>
                    <div>
                        @if (ViewBag.RecentBookings != null && ViewBag.RecentBookings.Count > 0)
                        {
                            @foreach (var booking in ViewBag.RecentBookings)
                            {
                                <div class="booking-item">
                                    <span class="booking-name">@booking.Member?.FullName</span>
                                    <span class="booking-type">@booking.Schedule?.Class?.ClassName</span>
                                    <span class="booking-date">@booking.BookedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">No recent bookings</div>
                        }
                    </div>
                </div>

                <div class="dashboard-card">
                    <div class="card-header">
                        <h2><i class="fas fa-calendar-alt" style="color:#536cf5;"></i> Upcoming Classes</h2>
                    </div>
                    <div>
                        @if (ViewBag.UpcomingClasses != null && ViewBag.UpcomingClasses.Count > 0)
                        {
                            @foreach (var schedule in ViewBag.UpcomingClasses)
                            {
                                <div class="booking-item">
                                    <span class="booking-name">@schedule.Class?.ClassName</span>
                                    <span class="booking-type">@schedule.Venue</span>
                                    <span class="booking-date">@schedule.ScheduleDate.ToString("dd/MM/yyyy") @schedule.StartTime.ToString(@"hh\:mm")</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">No upcoming classes</div>
                        }
                    </div>
                </div>
            </div>

        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
            // Monthly Bookings Chart
            var ctx = document.getElementById('monthlyBookingChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(ViewBag.MonthLabels ?? new string[] { })),
                    datasets: [{
                        label: 'Bookings',
                        data: @Html.Raw(Json.Serialize(ViewBag.MonthData ?? new int[] { })),
                        backgroundColor: '#536cf5',
                        borderRadius: 6,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1 } }
                    }
                }
            });
    </script>

</body>
</html>