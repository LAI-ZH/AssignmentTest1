@{
    ViewData["Title"] = "My Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-user me-2"></i>My Dashboard</h2>
        <span class="badge bg-primary p-2">Welcome, @User.Identity.Name!</span>
    </div>
    <hr />

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-white-50">Total Bookings</h6>
                            <h2 class="card-text mb-0">@ViewBag.TotalBookings</h2>
                        </div>
                        <i class="fas fa-calendar-check fa-3x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card text-white bg-success shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-white-50">Upcoming Classes</h6>
                            <h2 class="card-text mb-0">@ViewBag.UpcomingBookings?.Count</h2>
                        </div>
                        <i class="fas fa-calendar-alt fa-3x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>My Upcoming Classes</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.UpcomingBookings != null && ViewBag.UpcomingBookings.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Class</th>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>Venue</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in ViewBag.UpcomingBookings)
                                    {
                                        <tr>
                                            <td><strong>@booking.Schedule?.Class?.ClassName</strong></td>
                                            <td>@booking.Schedule?.ScheduleDate.ToString("dd/MM/yyyy")</td>
                                            <td>@booking.Schedule?.StartTime.ToString(@"hh\:mm") - @booking.Schedule?.EndTime.ToString(@"hh\:mm")</td>
                                            <td>@booking.Schedule?.Venue</td>
                                            <td><span class="badge bg-success">Confirmed</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">You have no upcoming classes.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>Booking History</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.MyBookings != null && ViewBag.MyBookings.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Class</th>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>Status</th>
                                        <th>Booked On</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in ViewBag.MyBookings)
                                    {
                                        <tr>
                                            <td>@booking.Schedule?.Class?.ClassName</td>
                                            <td>@booking.Schedule?.ScheduleDate.ToString("dd/MM/yyyy")</td>
                                            <td>@booking.Schedule?.StartTime.ToString(@"hh\:mm")</td>
                                            <td>
                                                @if (booking.Status == "Confirmed")
                                                {
                                                    <span class="badge bg-success">Confirmed</span>
                                                }
                                                else if (booking.Status == "Cancelled")
                                                {
                                                    <span class="badge bg-danger">Cancelled</span>
                                                }
                                                else if (booking.Status == "Attended")
                                                {
                                                    <span class="badge bg-info">Attended</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@booking.Status</span>
                                                }
                                            </td>
                                            <td>@booking.BookedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">No booking history.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <a asp-controller="Booking" asp-action="ClassCatalog" class="btn btn-outline-primary w-100">
                                <i class="fas fa-search me-2"></i>Browse Classes
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-success w-100">
                                <i class="fas fa-calendar-check me-2"></i>My Bookings
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Membership" asp-action="Plans" class="btn btn-outline-warning w-100">
                                <i class="fas fa-crown me-2"></i>Membership Plans
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}