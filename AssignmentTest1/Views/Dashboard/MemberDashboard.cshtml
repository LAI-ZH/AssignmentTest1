@{
    ViewData["Title"] = "Member Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />

<style>
    .db-root {
        font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
        padding: 2rem 0;
        max-width: 960px;
        margin: 0 auto;
    }

    .db-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 2.5rem;
    }

    .db-header h1 {
        font-size: 22px;
        font-weight: 500;
        margin: 0;
        color: #1A1A2E;
        letter-spacing: -0.02em;
    }

    .db-welcome {
        font-size: 13px;
        color: #6B7280;
    }

    .stats-band {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        background: #E5E7EB;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 2.5rem;
    }

    .stat-cell {
        background: #ffffff;
        padding: 1.5rem 1.75rem;
    }

    .stat-cell:first-child {
        border-left: 3px solid #4F6EF7;
    }

    .stat-cell:last-child {
        border-left: 3px solid #22C55E;
    }

    .stat-label {
        font-size: 12px;
        color: #6B7280;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 0.4rem;
    }

    .stat-num {
        font-size: 36px;
        font-weight: 500;
        letter-spacing: -0.03em;
        color: #1A1A2E;
        font-variant-numeric: tabular-nums;
        line-height: 1;
    }

    .db-section {
        margin-bottom: 2rem;
    }

    .section-title {
        font-size: 12px;
        font-weight: 500;
        color: #6B7280;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin: 0 0 0.75rem;
    }

    .db-card {
        background: #ffffff;
        border: 0.5px solid #E5E7EB;
        border-radius: 12px;
        overflow: hidden;
    }

    .db-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .db-table th {
        font-size: 12px;
        font-weight: 500;
        color: #6B7280;
        text-align: left;
        padding: 0.75rem 1rem;
        border-bottom: 0.5px solid #E5E7EB;
        letter-spacing: 0.03em;
    }

    .db-table td {
        padding: 0.8rem 1rem;
        color: #1A1A2E;
        border-bottom: 0.5px solid #F3F4F6;
    }

    .db-table tbody tr:last-child td {
        border-bottom: none;
    }

    .db-table tbody tr:hover td {
        background: #F9FAFB;
    }

    .db-table .td-strong {
        font-weight: 500;
    }

    .db-empty {
        padding: 2.5rem 1rem;
        text-align: center;
        font-size: 14px;
        color: #9CA3AF;
    }

    .badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 500;
        padding: 3px 9px;
        border-radius: 99px;
        letter-spacing: 0.02em;
    }

    .badge-confirmed { background: #EAF3DE; color: #3B6D11; }
    .badge-cancelled { background: #FCEBEB; color: #A32D2D; }
    .badge-attended  { background: #E6F1FB; color: #185FA5; }
    .badge-default   { background: #F3F4F6; color: #6B7280; }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .action-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0.75rem 1rem;
        border: 0.5px solid #D1D5DB;
        border-radius: 8px;
        background: #ffffff;
        font-size: 13px;
        color: #1A1A2E;
        text-decoration: none;
        transition: background 0.15s;
    }

    .action-btn:hover {
        background: #F9FAFB;
        color: #1A1A2E;
        text-decoration: none;
    }

    .action-btn i {
        font-size: 16px;
        color: #6B7280;
    }

    @@media (max-width: 600px) {
        .stats-band { grid-template-columns: 1fr; }
        .actions-grid { grid-template-columns: 1fr; }
        .db-header { flex-direction: column; gap: 0.25rem; }
    }
</style>

<div class="db-root">
    <div class="db-header">
        <h1>My Dashboard</h1>
        <span class="db-welcome">Welcome back, <strong>@User.Identity.Name</strong></span>
    </div>

    <div class="stats-band">
        <div class="stat-cell">
            <div class="stat-label">Total bookings</div>
            <div class="stat-num">@ViewBag.TotalBookings</div>
        </div>
        <div class="stat-cell">
            <div class="stat-label">Upcoming classes</div>
            <div class="stat-num">@(ViewBag.UpcomingBookings?.Count ?? 0)</div>
        </div>
    </div>

    <div class="db-section">
        <p class="section-title">Upcoming classes</p>
        <div class="db-card">
            @if (ViewBag.UpcomingBookings != null && ViewBag.UpcomingBookings.Count > 0)
            {
                <table class="db-table">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Venue</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in ViewBag.UpcomingBookings)
                        {
                            <tr>
                                <td class="td-strong">@booking.Schedule?.Class?.ClassName</td>
                                <td>@booking.Schedule?.ScheduleDate.ToString("dd/MM/yyyy")</td>
                                <td>@booking.Schedule?.StartTime.ToString(@"hh\:mm") – @booking.Schedule?.EndTime.ToString(@"hh\:mm")</td>
                                <td>@booking.Schedule?.Venue</td>
                                <td><span class="badge badge-confirmed">Confirmed</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="db-empty">No upcoming classes. Browse the schedule to book one.</p>
            }
        </div>
    </div>

    <div class="db-section">
        <p class="section-title">Booking history</p>
        <div class="db-card">
            @if (ViewBag.MyBookings != null && ViewBag.MyBookings.Count > 0)
            {
                <table class="db-table">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Booked on</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in ViewBag.MyBookings)
                        {
                            <tr>
                                <td>@booking.Schedule?.Class?.ClassName</td>
                                <td>@booking.Schedule?.ScheduleDate.ToString("dd/MM/yyyy")</td>
                                <td>@booking.Schedule?.StartTime.ToString(@"hh\:mm")</td>
                                <td>
                                    @if (booking.Status == "Confirmed")
                                    {
                                        <span class="badge badge-confirmed">Confirmed</span>
                                    }
                                    else if (booking.Status == "Cancelled")
                                    {
                                        <span class="badge badge-cancelled">Cancelled</span>
                                    }
                                    else if (booking.Status == "Attended")
                                    {
                                        <span class="badge badge-attended">Attended</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-default">@booking.Status</span>
                                    }
                                </td>
                                <td>@booking.BookedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="db-empty">No booking history yet.</p>
            }
        </div>
    </div>

    <div class="db-section">
        <p class="section-title">Quick actions</p>
        <div class="actions-grid">
            <a asp-controller="Booking" asp-action="ClassCatalog" class="action-btn">
                <i class="ti ti-search" aria-hidden="true"></i> Browse classes
            </a>
            <a asp-controller="Booking" asp-action="MyBookings" class="action-btn">
                <i class="ti ti-calendar-check" aria-hidden="true"></i> My bookings
            </a>
            <a asp-controller="Membership" asp-action="Plans" class="action-btn">
                <i class="ti ti-crown" aria-hidden="true"></i> Membership plans
            </a>
        </div>
    </div>
</div>
