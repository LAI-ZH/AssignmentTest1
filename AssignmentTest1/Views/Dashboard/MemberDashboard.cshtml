@{
    ViewData["Title"] = "Member Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/MemberDashboard.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="db-root">
    <div class="db-header">
        <h1><i class="fas fa-user me-2"></i>Member Dashboard</h1>
        <span class="db-welcome">Welcome back, <strong>@User.Identity.Name</strong></span>
    </div>

    <!-- Stats -->
    <div class="stats-band">
        <div class="stat-cell">
            <div class="stat-label">Total bookings</div>
            <div class="stat-num">@ViewBag.TotalBookings</div>
        </div>
        <div class="stat-cell">
            <div class="stat-label">Upcoming classes</div>
            <div class="stat-num">@(ViewBag.UpcomingBookings?.Count ?? 0)</div>
        </div>
    </div>

    <!-- Upcoming Classes -->
    <div class="db-section">
        <p class="section-title"><i class="fas fa-calendar-alt me-1"></i>Upcoming classes</p>
        <div class="db-card">
            @if (ViewBag.UpcomingBookings != null && ViewBag.UpcomingBookings.Count > 0)
            {
                <table class="db-table">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Venue</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in ViewBag.UpcomingBookings)
                        {
                            <tr>
                                <td class="td-strong">@booking.Schedule?.Class?.ClassName</td>
                                <td>@booking.Schedule?.ScheduleDate.ToString("dd/MM/yyyy")</td>
                                <td>@booking.Schedule?.StartTime.ToString(@"hh\:mm") – @booking.Schedule?.EndTime.ToString(@"hh\:mm")</td>
                                <td>@booking.Schedule?.Venue</td>
                                <td><span class="badge-custom badge-confirmed">Confirmed</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="db-empty">No upcoming classes. Browse the schedule to book one.</p>
            }
        </div>
    </div>

    <!-- Booking History -->
    <div class="db-section">
        <p class="section-title"><i class="fas fa-history me-1"></i>Booking history</p>
        <div class="db-card">
            @if (ViewBag.MyBookings != null && ViewBag.MyBookings.Count > 0)
            {
                <table class="db-table">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Booked on</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in ViewBag.MyBookings)
                        {
                            <tr>
                                <td>@booking.Schedule?.Class?.ClassName</td>
                                <td>@booking.Schedule?.ScheduleDate.ToString("dd/MM/yyyy")</td>
                                <td>@booking.Schedule?.StartTime.ToString(@"hh\:mm")</td>
                                <td>
                                    @if (booking.Status == "Confirmed")
                                    {
                                        <span class="badge-custom badge-confirmed">Confirmed</span>
                                    }
                                    else if (booking.Status == "Cancelled")
                                    {
                                        <span class="badge-custom badge-cancelled">Cancelled</span>
                                    }
                                    else if (booking.Status == "Attended")
                                    {
                                        <span class="badge-custom badge-attended">Attended</span>
                                    }
                                    else
                                    {
                                        <span class="badge-custom badge-default">@booking.Status</span>
                                    }
                                </td>
                                <td>@booking.BookedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="db-empty">No booking history yet.</p>
            }
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="db-section">
        <p class="section-title"><i class="fas fa-bolt me-1"></i>Quick actions</p>
        <div class="actions-grid">
            <a asp-controller="Booking" asp-action="ClassCatalog" class="action-btn">
                <i class="fas fa-search"></i> Browse classes
            </a>
            <a asp-controller="Booking" asp-action="MyBookings" class="action-btn">
                <i class="fas fa-calendar-check"></i> My bookings
            </a>
            <a asp-controller="Membership" asp-action="MemberPlans" class="action-btn">
                <i class="fas fa-crown"></i> Membership plans
            </a>
        </div>
    </div>
</div>