@{
    ViewData["Title"] = "Home - FitBook";
}

<style>
    .hero-section {
        padding: 4rem 0 3rem;
        text-align: center;
        background: linear-gradient(135deg, #F4F6FA 0%, #EEF1FF 100%);
        border-radius: 16px;
        margin-bottom: 2rem;
    }

        .hero-section .hero-icon {
            font-size: 72px;
            color: var(--primary);
            margin-bottom: 1rem;
        }

        .hero-section h1 {
            font-size: 3rem;
            font-weight: 700;
            color: var(--dark);
            letter-spacing: -0.02em;
        }

            .hero-section h1 span {
                color: var(--primary);
            }

        .hero-section .lead {
            font-size: 1.2rem;
            color: var(--secondary);
            max-width: 600px;
            margin: 0 auto 1.5rem;
        }

    .feature-card {
        background: var(--white);
        border: 0.5px solid var(--gray-light);
        border-radius: var(--radius);
        padding: 2rem 1.5rem;
        text-align: center;
        transition: var(--transition);
        height: 100%;
    }

        .feature-card:hover {
            box-shadow: var(--shadow-hover);
            transform: translateY(-4px);
        }

        .feature-card .feature-icon {
            font-size: 40px;
            color: var(--primary);
            margin-bottom: 1rem;
        }

        .feature-card h5 {
            font-weight: 600;
            color: var(--dark);
            margin-bottom: 0.5rem;
        }

        .feature-card p {
            font-size: 0.95rem;
            color: var(--secondary);
            margin-bottom: 0;
        }

    .hero-actions .btn {
        padding: 0.7rem 2.5rem;
        font-size: 1rem;
        border-radius: 50px;
    }
</style>

<div class="container mt-4">
    <div class="hero-section fade-in-up">
        <div class="hero-icon">
            <i class="fas fa-dumbbell"></i>
        </div>
        <h1>Welcome to <span>FitBook</span></h1>
        <p class="lead">Your Fitness Class Booking System</p>
        <p style="color: var(--secondary); max-width: 500px; margin: 0 auto 1.5rem;">
            Book your favorite fitness classes, track your progress, and achieve your goals.
        </p>
        <div class="hero-actions d-flex gap-3 justify-content-center flex-wrap">
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("Member"))
                {
                    <a asp-controller="Booking" asp-action="ClassCatalog" class="btn btn-primary">
                        <i class="fas fa-search me-2"></i>Browse Classes
                    </a>
                    <a asp-controller="Dashboard" asp-action="MemberDashboard" class="btn btn-outline-primary">
                        <i class="fas fa-chart-pie me-2"></i>Dashboard
                    </a>
                }
                else if (User.IsInRole("Trainer"))
                {
                    <a asp-controller="Dashboard" asp-action="TrainerDashboard" class="btn btn-primary">
                        <i class="fas fa-chart-pie me-2"></i>Dashboard
                    </a>
                }
                else if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                        <i class="fas fa-chart-pie me-2"></i>Dashboard
                    </a>
                }
            }
            else
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary">
                    <i class="fas fa-user-plus me-2"></i>Get Started
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">
                    <i class="fas fa-sign-in-alt me-2"></i>Login
                </a>
            }
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="feature-card fade-in-up" style="animation-delay: 0.1s;">
                <div class="feature-icon"><i class="fas fa-search"></i></div>
                <h5>Browse Classes</h5>
                <p>Find the perfect fitness class for you</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card fade-in-up" style="animation-delay: 0.2s;">
                <div class="feature-icon"><i class="fas fa-calendar-check"></i></div>
                <h5>Book Instantly</h5>
                <p>Book your spot with one click</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card fade-in-up" style="animation-delay: 0.3s;">
                <div class="feature-icon"><i class="fas fa-chart-line"></i></div>
                <h5>Track Progress</h5>
                <p>View your booking history and upcoming classes</p>
            </div>
        </div>
    </div>
</div>