@model IEnumerable<AssignmentTest1.Models.Entities.ClassScheduleTemplate>

@{
    ViewData["Title"] = "Manage Templates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-clone me-2"></i>Schedule Templates</h2>
        <div>
            <a asp-action="CreateTemplate" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Create Template
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-calendar-alt me-2"></i>View Schedule
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Class</th>
                        <th>Day</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Venue</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Class?.ClassName</td>
                            <td>@item.DayOfWeek</td>
                            <td>@item.StartTime</td>
                            <td>@item.EndTime</td>
                            <td>@item.Venue</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-action="EditTemplate" asp-route-id="@item.TemplateId" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal"
                                        data-id="@item.TemplateId" data-name="@item.Class?.ClassName">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <button id="generateBtn" class="btn btn-success" onclick="generateSchedules()">
                <i class="fas fa-sync me-2"></i>Generate Schedules From Templates
            </button>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-clone fa-3x text-muted mb-3"></i>
            <p class="text-muted">No templates created yet.</p>
            <a asp-action="CreateTemplate" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Create Your First Template
            </a>
        </div>
    }
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete template for <strong id="deleteTemplateName"></strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="DeleteTemplate" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteTemplateId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Delete modal
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function(event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            document.getElementById('deleteTemplateId').value = id;
            document.getElementById('deleteTemplateName').textContent = name;
        });

        // Generate schedules
        function generateSchedules() {
            if (confirm('Generate schedules for this week from templates?')) {
                $.ajax({
                    url: '@Url.Action("GenerateSchedules", "Schedule")',
                    type: 'POST',
                    data: {
                        startDate: new Date().toISOString().split('T')[0],
                        weeks: 1
                    },
                    success: function(data) {
                        alert(`Generated ${data.created} schedules. Skipped ${data.skipped} existing.`);
                        location.reload();
                    },
                    error: function() {
                        alert('Error generating schedules. Please try again.');
                    }
                });
            }
        }
    </script>
}