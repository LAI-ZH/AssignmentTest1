@{
    ViewData["Title"] = "Book Private Session";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-user-tie me-2"></i>Book Private Session</h2>
    <p class="text-muted">You have <strong>@ViewBag.RemainingSessions</strong> private session(s) remaining.</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        </div>
    }

    <form asp-action="BookPrivateSession" method="post">
        @Html.AntiForgeryToken()

        <div class="card">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Select Trainer</label>
                    <select name="trainerId" class="form-select" required>
                        <option value="">-- Select Trainer --</option>
                        @if (ViewBag.Trainers != null)
                        {
                            foreach (var trainer in ViewBag.Trainers)
                            {
                                <option value="@trainer.UserId">@trainer.FullName</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Preferred Date</label>
                    <input type="date" name="preferredDate" class="form-control" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Preferred Time</label>
                    <input type="time" name="preferredTime" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Notes (Optional)</label>
                    <textarea name="notes" class="form-control" rows="3" placeholder="Any specific goals or requests..."></textarea>
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-check me-2"></i>Book Session
                </button>
                <a href="@Url.Action("MySubscription", "Membership")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Cancel
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // 设置日期选择器最小值为今天
        document.addEventListener('DOMContentLoaded', function() {
            var dateInput = document.querySelector('input[name="preferredDate"]');
            if (dateInput) {
                var today = new Date().toISOString().split('T')[0];
                dateInput.setAttribute('min', today);
            }
        });
    </script>
}