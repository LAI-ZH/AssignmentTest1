@model IEnumerable<AssignmentTest1.Models.Entities.PrivateSession>

@{
    ViewData["Title"] = "My Private Sessions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-user-tie me-2"></i>My Private Sessions</h2>
    <p class="text-muted">View all your private training session bookings.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Trainer</th>
                        <th>Preferred Date</th>
                        <th>Preferred Time</th>
                        <th>Notes</th>
                        <th>Status</th>
                        <th>Booked On</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderByDescending(m => m.BookedAt))
                    {
                        <tr>
                            <td>@(item.Trainer?.FullName ?? "N/A")</td>
                            <td>@item.PreferredDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.PreferredTime.ToString(@"hh\:mm")</td>
                            <td>@(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)</td>
                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (item.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="badge bg-primary">Completed</span>
                                }
                                else if (item.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>
                            <td>@item.BookedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-user-tie fa-3x text-muted mb-3"></i>
            <p class="text-muted">You haven't booked any private sessions yet.</p>
            <a href="@Url.Action("BookPrivateSession", "Booking")" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Book Your First Session
            </a>
        </div>
    }
</div>