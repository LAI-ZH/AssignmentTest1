@model AssignmentTest1.Models.Entities.FitnessClass

@{
    ViewData["Title"] = "Class Details - " + Model.ClassName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .detail-row {
        display: flex;
        padding: 0.5rem 0;
        border-bottom: 0.5px solid #F3F4F6;
    }

    .detail-label {
        width: 150px;
        font-weight: 500;
        color: #6B7280;
    }

    .detail-value {
        flex: 1;
        color: #1A1A2E;
    }

    .badge-available {
        background: #EAF3DE;
        color: #3B6D11;
    }

    .badge-full {
        background: #FCEBEB;
        color: #A32D2D;
    }

    .badge-booked {
        background: #E6F1FB;
        color: #185FA5;
    }
</style>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4><i class="fas fa-dumbbell me-2"></i>@Model.ClassName</h4>
                </div>
                <div class="card-body">
                    <!-- Class Info -->
                    <div class="detail-row">
                        <span class="detail-label">Category</span>
                        <span class="detail-value"><span class="badge bg-secondary">@Model.Category</span></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Trainer</span>
                        <span class="detail-value">@Model.Trainer?.FullName</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Description</span>
                        <span class="detail-value">@(Model.Description ?? "No description")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Max Capacity</span>
                        <span class="detail-value">@Model.MaxCapacity</span>
                    </div>

                    <!-- Upcoming Schedules -->
                    @if (ViewBag.UpcomingSchedules != null && ViewBag.UpcomingSchedules.Count > 0)
                    {
                        <hr />
                        <h5><i class="fas fa-calendar-alt me-2"></i>Upcoming Sessions</h5>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>Venue</th>
                                        <th>Availability</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var schedule in ViewBag.UpcomingSchedules)
                                    {
                                        var confirmedCount = schedule.Bookings?.Count(b => b.Status == "Confirmed" || b.Status == "Attended") ?? 0;
                                        var isFull = confirmedCount >= Model.MaxCapacity;
                                        var memberId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                                        var hasBooked = false;

                                        if (memberId != null)
                                        {
                                            var memberIdInt = int.Parse(memberId);
                                            hasBooked = schedule.Bookings?.Any(b => b.MemberId == memberIdInt && b.Status != "Cancelled") ?? false;
                                        }

                                        <tr>
                                            <td>@schedule.ScheduleDate.ToString("dd/MM/yyyy")</td>
                                            <td>@schedule.StartTime.ToString(@"hh\:mm") - @schedule.EndTime.ToString(@"hh\:mm")</td>
                                            <td>@schedule.Venue</td>
                                            <td>
                                                @if (hasBooked)
                                                {
                                                    <span class="badge badge-booked">Booked</span>
                                                }
                                                else if (isFull)
                                                {
                                                    <span class="badge badge-full">Full</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-available">@(Model.MaxCapacity - confirmedCount) spots left</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!hasBooked && !isFull)
                                                {
                                                    <form asp-action="Book" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="scheduleId" value="@schedule.ScheduleId" />
                                                        <button type="submit" class="btn btn-success btn-sm">
                                                            <i class="fas fa-check me-1"></i>Book
                                                        </button>
                                                    </form>
                                                }
                                                else if (hasBooked)
                                                {
                                                    <span class="text-muted small">Already booked</span>
                                                }
                                                else if (isFull)
                                                {
                                                    <span class="text-muted small">Full</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <hr />
                        <p class="text-muted text-center">No upcoming sessions available.</p>
                    }

                    <div class="mt-4">
                        <a asp-action="ClassCatalog" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Back to Classes
                        </a>
                        <a asp-action="MyBookings" class="btn btn-outline-info ms-2">
                            <i class="fas fa-calendar-check me-2"></i>My Bookings
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>