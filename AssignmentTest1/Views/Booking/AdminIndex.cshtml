@model AssignmentTest1.Models.ViewModels.BookingIndexViewModel

@{
    ViewData["Title"] = "Manage Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

        .page-header h2 {
            margin: 0;
        }

    .filter-bar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 1rem;
        background: #ffffff;
        padding: 0.75rem 1.25rem;
        border-radius: 12px;
        border: 0.5px solid #E5E7EB;
    }

        .filter-bar .search-box {
            flex: 1;
            min-width: 200px;
            position: relative;
        }

            .filter-bar .search-box input {
                width: 100%;
                padding: 0.5rem 1rem 0.5rem 2.5rem;
                border: 0.5px solid #E5E7EB;
                border-radius: 8px;
                font-size: 14px;
                background: #F9FAFB;
                transition: border-color 0.2s;
            }

                .filter-bar .search-box input:focus {
                    outline: none;
                    border-color: #4F6EF7;
                    background: #ffffff;
                }

            .filter-bar .search-box i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: #9CA3AF;
            }

        .filter-bar .status-filter select {
            padding: 0.5rem 1rem;
            border: 0.5px solid #E5E7EB;
            border-radius: 8px;
            font-size: 14px;
            background: #F9FAFB;
            color: #1A1A2E;
            min-width: 140px;
            cursor: pointer;
        }

    .badge-confirmed {
        background: #EAF3DE;
        color: #3B6D11;
    }

    .badge-cancelled {
        background: #FCEBEB;
        color: #A32D2D;
    }

    .badge-attended {
        background: #E6F1FB;
        color: #185FA5;
    }

    .badge-waitlist {
        background: #FFF3CD;
        color: #856404;
    }

    .table-action {
        display: flex;
        gap: 5px;
    }

        .table-action .btn {
            padding: 0.2rem 0.5rem;
            font-size: 13px;
        }

    .sort-link {
        color: #6B7280;
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .sort-link:hover {
            color: #1A1A2E;
        }

        .sort-link.active {
            color: #4F6EF7;
        }

    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .pagination-info {
        font-size: 14px;
        color: #6B7280;
    }

        .pagination-info strong {
            color: #1A1A2E;
        }

    .page-size-select {
        padding: 0.3rem 0.6rem;
        border: 0.5px solid #E5E7EB;
        border-radius: 6px;
        font-size: 13px;
        background: #F9FAFB;
    }

    .pagination {
        display: flex;
        gap: 4px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .pagination li {
            display: inline;
        }

            .pagination li a, .pagination li span {
                display: inline-block;
                padding: 0.4rem 0.8rem;
                border-radius: 6px;
                font-size: 14px;
                color: #6B7280;
                text-decoration: none;
                border: 0.5px solid transparent;
                transition: all 0.2s;
                min-width: 36px;
                text-align: center;
            }

                .pagination li a:hover {
                    background: #F9FAFB;
                    border-color: #E5E7EB;
                    color: #1A1A2E;
                }

            .pagination li.active a {
                background: #4F6EF7;
                color: white;
                border-color: #4F6EF7;
            }

            .pagination li.disabled span {
                color: #D1D5DB;
                cursor: not-allowed;
            }

    .status-passed {
        color: #6B7280;
        font-size: 12px;
    }
</style>

<div class="container mt-4">
    <!-- Page Header -->
    <div class="page-header">
        <h2><i class="fas fa-calendar-check me-2"></i>Manage Bookings</h2>
        <span class="badge bg-info p-2">Total: @Model.TotalCount</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Bar -->
    <div class="filter-bar">
        <form method="get" class="d-flex gap-2 flex-wrap align-items-center w-100">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" name="search" placeholder="Search by member, class, venue..." value="@Model.SearchTerm" />
            </div>
            <!-- ✅ 状态筛选 -->
            <select name="status" class="status-filter">
                <option value="">All Status</option>
                <option value="Confirmed" selected="@(Model.SelectedStatus == "Confirmed")">✅ Confirmed</option>
                <option value="Attended" selected="@(Model.SelectedStatus == "Attended")">📋 Attended</option>
                <option value="Cancelled" selected="@(Model.SelectedStatus == "Cancelled")">❌ Cancelled</option>
                <option value="Waitlist" selected="@(Model.SelectedStatus == "Waitlist")">⏳ Waitlist</option>
            </select>
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="fas fa-search me-1"></i>Filter
            </button>
            <a asp-action="AdminIndex" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-undo me-1"></i>Clear
            </a>
            <span class="ms-auto text-muted small">
                <strong>@Model.TotalCount</strong> bookings found
            </span>
        </form>
    </div>

    <!-- Booking Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a asp-action="AdminIndex" asp-route-sortBy="id" asp-route-sortOrder="@(Model.SortBy == "id" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-search="@Model.SearchTerm" asp-route-status="@Model.SelectedStatus" asp-route-page="@Model.CurrentPage" asp-route-pageSize="@Model.PageSize"
                                   class="sort-link @(Model.SortBy == "id" ? "active" : "")">
                                    ID
                                    @if (Model.SortBy == "id")
                                    {
                                        <i class="fas fa-chevron-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="AdminIndex" asp-route-sortBy="member" asp-route-sortOrder="@(Model.SortBy == "member" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-search="@Model.SearchTerm" asp-route-status="@Model.SelectedStatus" asp-route-page="@Model.CurrentPage" asp-route-pageSize="@Model.PageSize"
                                   class="sort-link @(Model.SortBy == "member" ? "active" : "")">
                                    Member
                                    @if (Model.SortBy == "member")
                                    {
                                        <i class="fas fa-chevron-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="AdminIndex" asp-route-sortBy="class" asp-route-sortOrder="@(Model.SortBy == "class" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-search="@Model.SearchTerm" asp-route-status="@Model.SelectedStatus" asp-route-page="@Model.CurrentPage" asp-route-pageSize="@Model.PageSize"
                                   class="sort-link @(Model.SortBy == "class" ? "active" : "")">
                                    Class
                                    @if (Model.SortBy == "class")
                                    {
                                        <i class="fas fa-chevron-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="AdminIndex" asp-route-sortBy="date" asp-route-sortOrder="@(Model.SortBy == "date" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-search="@Model.SearchTerm" asp-route-status="@Model.SelectedStatus" asp-route-page="@Model.CurrentPage" asp-route-pageSize="@Model.PageSize"
                                   class="sort-link @(Model.SortBy == "date" ? "active" : "")">
                                    Date
                                    @if (Model.SortBy == "date")
                                    {
                                        <i class="fas fa-chevron-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>Time</th>
                            <th>Venue</th>
                            <th>
                                <a asp-action="AdminIndex" asp-route-sortBy="status" asp-route-sortOrder="@(Model.SortBy == "status" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-search="@Model.SearchTerm" asp-route-status="@Model.SelectedStatus" asp-route-page="@Model.CurrentPage" asp-route-pageSize="@Model.PageSize"
                                   class="sort-link @(Model.SortBy == "status" ? "active" : "")">
                                    Status
                                    @if (Model.SortBy == "status")
                                    {
                                        <i class="fas fa-chevron-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="AdminIndex" asp-route-sortBy="bookedat" asp-route-sortOrder="@(Model.SortBy == "bookedat" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-search="@Model.SearchTerm" asp-route-status="@Model.SelectedStatus" asp-route-page="@Model.CurrentPage" asp-route-pageSize="@Model.PageSize"
                                   class="sort-link @(Model.SortBy == "bookedat" ? "active" : "")">
                                    Booked On
                                    @if (Model.SortBy == "bookedat")
                                    {
                                        <i class="fas fa-chevron-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Bookings)
                        {
                            var today = DateOnly.FromDateTime(DateTime.Now);
                            var isPassed = item.Schedule?.ScheduleDate < today;

                            <tr>
                                <td>@item.BookingId</td>
                                <td>@item.Member?.FullName</td>
                                <td><strong>@item.Schedule?.Class?.ClassName</strong></td>
                                <td>@item.Schedule?.ScheduleDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.Schedule?.StartTime.ToString(@"hh\:mm")</td>
                                <td>@item.Schedule?.Venue</td>
                                <td>
                                    @if (item.Status == "Confirmed")
                                    {
                                        <span class="badge badge-confirmed">Confirmed</span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge badge-cancelled">Cancelled</span>
                                    }
                                    else if (item.Status == "Attended")
                                    {
                                        <span class="badge badge-attended">Attended ✅</span>
                                    }
                                    else if (item.Status == "Waitlist")
                                    {
                                        <span class="badge badge-waitlist">Waitlist</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                <td>@item.BookedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="table-action">
                                        @if (item.Status == "Confirmed")
                                        {
                                            <form asp-action="AdminCancel" method="post" class="d-inline" onsubmit="return confirm('Cancel this booking?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@item.BookingId" />
                                                <button type="submit" class="btn btn-danger btn-sm" title="Cancel">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        }
                                        else if (item.Status == "Cancelled" || item.Status == "Waitlist")
                                        {
                                            <form asp-action="AdminConfirm" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@item.BookingId" />
                                                <button type="submit" class="btn btn-success btn-sm" title="Confirm">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Bookings.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-calendar-check fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No bookings found.</p>
                </div>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container">
            <div class="pagination-info">
                Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> -
                <strong>@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong>
                of <strong>@Model.TotalCount</strong> bookings
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small mb-0">Rows:</label>
                    <select class="page-size-select" onchange="window.location.href=updatePageSize(this.value)">
                        <option value="5" selected="@(Model.PageSize == 5)">5</option>
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                    </select>
                </div>

                <ul class="pagination">
                    <li class="@(Model.CurrentPage <= 1 ? "disabled" : "")">
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-action="AdminIndex" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.SelectedStatus"
                               asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder"
                               asp-route-page="@(Model.CurrentPage - 1)" asp-route-pageSize="@Model.PageSize">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        }
                        else
                        {
                            <span><i class="fas fa-chevron-left"></i></span>
                        }
                    </li>

                    @{
                        var startPage = Math.Max(1, Model.CurrentPage - 2);
                        var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                        if (startPage > 1)
                        {
                            <li>
                                <a asp-action="AdminIndex" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.SelectedStatus"
                                   asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-page="1" asp-route-pageSize="@Model.PageSize">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="disabled"><span>...</span></li>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="@(i == Model.CurrentPage ? "active" : "")">
                                <a asp-action="AdminIndex" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.SelectedStatus"
                                   asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                            </li>
                        }

                        if (endPage < Model.TotalPages)
                        {
                            if (endPage < Model.TotalPages - 1)
                            {
                                <li class="disabled"><span>...</span></li>
                            }
                            <li>
                                <a asp-action="AdminIndex" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.SelectedStatus"
                                   asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-page="@Model.TotalPages" asp-route-pageSize="@Model.PageSize">@Model.TotalPages</a>
                            </li>
                        }
                    }

                    <li class="@(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-action="AdminIndex" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.SelectedStatus"
                               asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder"
                               asp-route-page="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        }
                        else
                        {
                            <span><i class="fas fa-chevron-right"></i></span>
                        }
                    </li>
                </ul>
            </div>
        </div>
    }

    <script>
            function updatePageSize(size) {
                var url = new URL(window.location.href);
                url.searchParams.set('pageSize', size);
                url.searchParams.set('page', 1);
                return url.toString();
            }
    </script>
</div>