@model IEnumerable<AssignmentTest1.Models.Entities.ClassSchedule>

@{
    ViewData["Title"] = "My Schedule";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

        .page-header h2 {
            margin: 0;
        }

    .badge-confirmed {
        background: #EAF3DE;
        color: #3B6D11;
    }

    .badge-attended {
        background: #E6F1FB;
        color: #185FA5;
    }

    .badge-cancelled {
        background: #FCEBEB;
        color: #A32D2D;
    }

    .badge-pending {
        background: #FFF3CD;
        color: #856404;
    }

    .schedule-row:hover {
        background: #F9FAFB;
    }

    .action-btn-sm {
        padding: 0.2rem 0.5rem;
        font-size: 12px;
    }
</style>

<div class="container mt-4">
    <div class="page-header">
        <h2><i class="fas fa-calendar-alt me-2"></i>My Schedule</h2>
        <span class="badge bg-info p-2">Total: @Model.Count()</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Class</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Venue</th>
                                <th>Bookings</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderBy(s => s.ScheduleDate))
                            {
                                var confirmedCount = item.Bookings?.Count(b => b.Status == "Confirmed" || b.Status == "Attended") ?? 0;
                                var totalCount = item.Bookings?.Count ?? 0;
                                <tr class="schedule-row">
                                    <td><strong>@item.Class?.ClassName</strong></td>
                                    <td>@item.ScheduleDate.ToString("dd/MM/yyyy")</td>
                                    <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                                    <td>@item.Venue</td>
                                    <td>
                                        <span class="badge badge-confirmed">@confirmedCount</span>
                                        / @(item.Class?.MaxCapacity ?? 0)
                                        @if (totalCount > confirmedCount)
                                        {
                                            <span class="badge badge-cancelled ms-1">@(totalCount - confirmedCount) cancelled</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="ScheduleDetails" asp-route-id="@item.ScheduleId" class="btn btn-sm btn-info action-btn-sm" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-calendar-alt fa-3x text-muted mb-3"></i>
                    <p class="text-muted">You have no schedules yet.</p>
                </div>
            }
        </div>
    </div>
</div>