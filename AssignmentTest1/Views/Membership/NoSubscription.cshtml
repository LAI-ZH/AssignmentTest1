@{
    ViewData["Title"] = "No Subscription";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <i class="fas fa-crown fa-4x text-muted mb-3"></i>
                    <h3>No Active Subscription</h3>
                    <p class="text-muted">You don't have an active membership plan.</p>

                    @if (ViewBag.ExpiredSubscription != null)
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-clock me-2"></i>
                            Your previous subscription (<strong>@ViewBag.ExpiredSubscription.Plan?.PlanName</strong>) expired on
                            @ViewBag.ExpiredSubscription.EndDate.ToString("dd/MM/yyyy").
                        </div>
                    }

                    <a asp-action="MemberPlans" class="btn btn-primary btn-lg mt-3">
                        <i class="fas fa-crown me-2"></i>Browse Plans
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>