<div class="container mt-4">
    <div class="scanner-container">

        <!-- Title -->
        <h2><i class="fas fa-qrcode me-2"></i>Scan QR Code</h2>
        <p class="text-muted">Show any QR code to your <strong>computer camera</strong></p>

        <!-- Amount -->
        <div class="text-center">
            <span class="amount-badge">
                <i class="fas fa-money-bill-wave me-2"></i>
                RM @ViewBag.Amount?.ToString("F2")
            </span>
        </div>

        <!-- QR Scanner -->
        <div id="qr-reader"></div>

        <!-- Status -->
        <div id="scan-status" class="scan-status">
            <i class="fas fa-spinner me-2"></i>
            Waiting for QR code...
        </div>

        <!-- Success Message -->
        <div id="success-message" class="success-message" style="display:none;">
            <div class="icon"><i class="fas fa-check-circle"></i></div>
            <h2>Payment Completed! ✅</h2>
            <p class="text-muted">Your subscription has been activated.</p>
            <div class="mt-3">
                <a asp-action="MySubscription" class="btn btn-primary">
                    <i class="fas fa-user-check me-2"></i>View My Subscription
                </a>
            </div>
        </div>

        <!-- Controls -->
        <div class="mt-3 d-flex gap-2 justify-content-center flex-wrap">
            <button id="startScanBtn" class="btn btn-primary">
                <i class="fas fa-play me-2"></i>Start Camera
            </button>
            <button id="stopScanBtn" class="btn btn-danger" style="display:none;">
                <i class="fas fa-stop me-2"></i>Stop Camera
            </button>
        </div>

        <!-- Back Button -->
        <div class="back-container">
            <a asp-action="MemberPlans" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Plans
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // ============================================================
        // Get PlanId from ViewBag
        // ============================================================

        var planId = @ViewBag.PlanId;
        console.log('PlanId from server:', planId);

        // ============================================================
        // Variables
        // ============================================================

        let html5QrCodeScanner = null;
        let isScanning = false;
        let isSuccess = false;

        const scanStatus = document.getElementById('scan-status');
        const successMessage = document.getElementById('success-message');
        const readerElement = document.getElementById('qr-reader');
        const startBtn = document.getElementById('startScanBtn');
        const stopBtn = document.getElementById('stopScanBtn');

        // ============================================================
        // Start Scanner
        // ============================================================

        function startScanner() {
            if (isScanning || isSuccess) return;

            if (typeof Html5Qrcode === 'undefined') {
                if (scanStatus) {
                    scanStatus.innerHTML = '<span class="text-danger">QR Code library not loaded. Please refresh.</span>';
                }
                return;
            }

            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                if (scanStatus) {
                    scanStatus.innerHTML = '<span class="text-danger">Camera not supported on this browser.</span>';
                }
                return;
            }

            try {
                html5QrCodeScanner = new Html5Qrcode('qr-reader');

                html5QrCodeScanner.start(
                    { facingMode: 'environment' },
                    { fps: 10, qrbox: { width: 250, height: 250 } },
                    onScanSuccess,
                    onScanError
                ).then(function() {
                    isScanning = true;
                    if (startBtn) startBtn.style.display = 'none';
                    if (stopBtn) stopBtn.style.display = 'inline-block';
                    if (scanStatus) {
                        scanStatus.innerHTML = '<i class="fas fa-camera me-2"></i>Camera is on. Show any QR code to scan.';
                    }
                }).catch(function(err) {
                    console.error('Camera error:', err);
                    if (scanStatus) {
                        scanStatus.innerHTML = '<span class="text-danger">Camera error: ' + err.message + '</span>';
                    }
                });

            } catch (err) {
                console.error('Scanner error:', err);
                if (scanStatus) {
                    scanStatus.innerHTML = '<span class="text-danger">Error: ' + err.message + '</span>';
                }
            }
        }

        // ============================================================
        // Stop Scanner
        // ============================================================

        function stopScanner() {
            if (html5QrCodeScanner && isScanning) {
                html5QrCodeScanner.stop().catch(function(err) {
                    console.error('Stop error:', err);
                });
                isScanning = false;
            }
            if (startBtn) startBtn.style.display = 'inline-block';
            if (stopBtn) stopBtn.style.display = 'none';
        }

        // ============================================================
        // On Scan Success
        // ============================================================

        function onScanSuccess(decodedText, decodedResult) {
            if (isSuccess) return;
            isSuccess = true;

            if (html5QrCodeScanner && isScanning) {
                html5QrCodeScanner.stop().catch(function(err) {
                    console.error('Stop error:', err);
                });
                isScanning = false;
            }

            console.log('QR Code detected!');

            if (scanStatus) {
                scanStatus.innerHTML = '<span class="text-success">✅ QR Code detected! Processing...</span>';
            }

            // 调用服务器创建订阅
            createSubscription();
        }

        // ============================================================
        // On Scan Error
        // ============================================================

        function onScanError(error) {
            // 忽略错误，继续扫描
        }

        // ============================================================
        // Create Subscription
        // ============================================================

        function createSubscription() {
            console.log('Creating subscription with PlanId:', planId);

            if (!planId || planId === 0) {
                alert('Error: Plan not selected. Please go back and try again.');
                if (scanStatus) {
                    scanStatus.innerHTML = '<span class="text-danger">Error: Plan not selected</span>';
                }
                isSuccess = false;
                startScanner();
                return;
            }

            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var tokenValue = token ? token.value : '';

            fetch('/Membership/CreateSubscriptionFromQR', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': tokenValue
                },
                body: JSON.stringify({
                    planId: planId
                })
            })
                .then(function(res) {
                    console.log('Response status:', res.status);
                    return res.json();
                })
                .then(function(data) {
                    console.log('Server response:', data);
                    if (data.success) {
                        // ✅ 跳转到 QRPaymentSuccess
                        window.location.href = '/Membership/QRPaymentSuccess?transactionId=' + data.transactionId;
                    } else {
                        alert('Payment failed: ' + (data.message || 'Unknown error'));
                        isSuccess = false;
                        startScanner();
                    }
                })
                .catch(function(err) {
                    console.error('Error:', err);
                    alert('Error processing payment. Please try again.');
                    isSuccess = false;
                    startScanner();
                });
        }

        // ============================================================
        // Event Listeners
        // ============================================================

        if (startBtn) {
            startBtn.addEventListener('click', startScanner);
        }

        if (stopBtn) {
            stopBtn.addEventListener('click', stopScanner);
        }

        // ============================================================
        // Auto-start on page load
        // ============================================================

        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(startScanner, 800);
        });

        // ============================================================
        // Cleanup on page unload
        // ============================================================

        window.addEventListener('beforeunload', function() {
            if (html5QrCodeScanner && isScanning) {
                html5QrCodeScanner.stop().catch(function(err) {
                    console.error('Stop error:', err);
                });
            }
        });
    </script>
}