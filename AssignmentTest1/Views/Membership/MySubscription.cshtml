@model AssignmentTest1.Models.Entities.MemberSubscription

@{
    ViewData["Title"] = "My Subscription";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .stat-box {
        text-align: center;
        padding: 1.25rem;
        background: #F9FAFB;
        border-radius: 8px;
        border: 0.5px solid #E5E7EB;
    }

        .stat-box .stat-number {
            font-size: 28px;
            font-weight: 600;
            color: #1A1A2E;
        }

        .stat-box .stat-label {
            font-size: 13px;
            color: #6B7280;
        }

    .progress {
        height: 8px;
        border-radius: 99px;
        background: #E5E7EB;
        margin-top: 0.5rem;
    }

    .progress-bar {
        border-radius: 99px;
        transition: width 0.5s ease;
    }

    .badge-active {
        background: #EAF3DE;
        color: #3B6D11;
    }

    .badge-expired {
        background: #FCEBEB;
        color: #A32D2D;
    }

    .badge-cancelled {
        background: #FFF3CD;
        color: #856404;
    }
</style>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4><i class="fas fa-user-check me-2"></i>My Subscription</h4>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Plan Info -->
                    <div class="text-center mb-4">
                        <h3>@Model.Plan?.PlanName</h3>
                        <span class="badge badge-active">Active</span>
                    </div>

                    <!-- Stats -->
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="stat-box">
                                <div class="stat-number">RM @Model.Plan?.Price.ToString("F2")</div>
                                <div class="stat-label">Price</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-box">
                                <div class="stat-number">@ViewBag.DaysRemaining</div>
                                <div class="stat-label">Days Remaining</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-box">
                                <div class="stat-number">
                                    @if (Model.Plan?.MaxBookings == 0)
                                    {
                                        <span>∞</span>
                                    }
                                    else
                                    {
                                        @ViewBag.BookingsRemaining
                                    }
                                </div>
                                <div class="stat-label">
                                    @if (Model.Plan?.MaxBookings == 0)
                                    {
                                        <span>Unlimited Classes</span>
                                    }
                                    else
                                    {
                                        <span>Classes Remaining</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ✅ 进度条（如果有限制次数） -->
                    @if (Model.Plan?.MaxBookings > 0)
                    {
                        var used = Model.Plan.MaxBookings - ViewBag.BookingsRemaining;
                        var percent = (double)used / Model.Plan.MaxBookings * 100;
                        var barColor = percent >= 80 ? "#DC3545" : percent >= 60 ? "#FFC107" : "#22C55E";

                        <div class="mt-3">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small">Used: @used / @Model.Plan.MaxBookings classes</span>
                                <span class="text-muted small">@(percent.ToString("F0"))%</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar" role="progressbar"
                                     style="width: @percent%; background: @barColor;"
                                     aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>
                            @if (percent >= 80)
                            {
                                <p class="text-danger small mt-1">
                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                    You are close to your monthly limit!
                                </p>
                            }
                            @if (percent >= 100)
                            {
                                <p class="text-danger small mt-1">
                                    <i class="fas fa-exclamation-circle me-1"></i>
                                    You have reached your monthly limit.
                                    <a asp-action="MemberPlans" class="text-primary">Upgrade your plan</a>
                                </p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mt-3 alert alert-info">
                            <i class="fas fa-infinity me-2"></i>
                            You have <strong>unlimited</strong> classes with your @Model.Plan?.PlanName plan!
                        </div>
                    }

                    <!-- Details -->
                    <div class="mt-4">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Start Date:</strong> @Model.StartDate.ToString("dd/MM/yyyy")</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>End Date:</strong> @Model.EndDate.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>
                        @if (Model.Plan?.MaxBookings > 0)
                        {
                            <p><strong>Classes Used:</strong> @(Model.Plan.MaxBookings - ViewBag.BookingsRemaining) / @Model.Plan.MaxBookings</p>
                        }
                        @if (Model.Plan?.PTSessions > 0)
                        {
                            <p><strong>PT Sessions Used:</strong> @Model.PT_Used / @Model.Plan.PTSessions</p>
                        }
                    </div>

                    <!-- Benefits -->
                    @if (!string.IsNullOrEmpty(Model.Plan?.Benefits))
                    {
                        <hr />
                        <h6><i class="fas fa-list me-2"></i>Benefits</h6>
                        <ul class="list-unstyled">
                            @foreach (var benefit in Model.Plan.Benefits.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries))
                            {
                                <li><i class="fas fa-check-circle text-success me-2"></i>@benefit.Trim()</li>
                            }
                        </ul>
                    }

                    <!-- Actions -->
                    <hr />
                    <div class="d-grid gap-2">
                        <a asp-controller="Booking" asp-action="ClassCatalog" class="btn btn-success">
                            <i class="fas fa-search me-2"></i>Browse Classes
                        </a>
                        <form asp-action="CancelSubscription" method="post" onsubmit="return confirm('Are you sure you want to cancel your subscription?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger w-100">
                                <i class="fas fa-times me-2"></i>Cancel Subscription
                            </button>
                        </form>
                        <a asp-action="MemberPlans" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Back to Plans
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>