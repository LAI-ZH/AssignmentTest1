@model AssignmentTest1.Models.ViewModels.PaymentViewModel

@{
    ViewData["Title"] = "Make Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .plan-summary {
        background: #F9FAFB;
        border-radius: 12px;
        padding: 1.5rem;
        border: 0.5px solid #E5E7EB;
    }

        .plan-summary .price {
            font-size: 28px;
            font-weight: 600;
            color: #1A1A2E;
        }

            .plan-summary .price small {
                font-size: 14px;
                font-weight: 400;
                color: #6B7280;
            }

    .payment-method-card {
        cursor: pointer;
        border: 2px solid #E5E7EB;
        border-radius: 12px;
        padding: 1.25rem;
        transition: all 0.2s;
    }

        .payment-method-card:hover {
            border-color: #4F6EF7;
        }

        .payment-method-card.selected {
            border-color: #4F6EF7;
            background: #F0F3FF;
        }

        .payment-method-card .method-icon {
            font-size: 32px;
            color: #4F6EF7;
        }

        .payment-method-card .method-name {
            font-weight: 600;
            margin-top: 0.5rem;
        }

        .payment-method-card .method-desc {
            font-size: 13px;
            color: #6B7280;
        }

    .card-input {
        position: relative;
    }

        .card-input .card-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 24px;
            color: #6B7280;
        }

    .benefits-list {
        list-style: none;
        padding: 0;
        margin: 0.5rem 0;
    }

        .benefits-list li {
            padding: 0.25rem 0;
            font-size: 14px;
        }

            .benefits-list li i {
                color: #22C55E;
                margin-right: 8px;
            }
</style>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4><i class="fas fa-credit-card me-2"></i>Make Payment</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Left: Plan Summary -->
                        <div class="col-md-5">
                            <div class="plan-summary">
                                <h5>@Model.PlanName</h5>
                                <div class="price">
                                    RM @Model.Price.ToString("F2")
                                    <small>/ @Model.DurationDays days</small>
                                </div>

                                <div class="mt-3">
                                    @if (Model.MaxBookings == 0)
                                    {
                                        <span class="badge bg-info">♾️ Unlimited Classes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Model.MaxBookings Classes</span>
                                    }
                                    @if (Model.PTSessions > 0)
                                    {
                                        <span class="badge bg-warning ms-1">💪 @Model.PTSessions PT</span>
                                    }
                                    @if (Model.IncludesGymAccess)
                                    {
                                        <span class="badge bg-success ms-1">🏋️ Gym Access</span>
                                    }
                                    @if (Model.IncludesInbody)
                                    {
                                        <span class="badge bg-info ms-1">⚖️ Inbody</span>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(Model.Description))
                                {
                                    <p class="text-muted small mt-2">@Model.Description</p>
                                }

                                @if (!string.IsNullOrEmpty(Model.Benefits))
                                {
                                    <ul class="benefits-list">
                                        @foreach (var benefit in Model.Benefits.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <li><i class="fas fa-check-circle"></i>@benefit.Trim()</li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>

                        <!-- Right: Payment Form -->
                        <div class="col-md-7">
                            <form asp-action="MakePayment" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="PlanId" />
                                <input type="hidden" asp-for="PlanName" />
                                <input type="hidden" asp-for="Price" />
                                <input type="hidden" asp-for="DurationDays" />
                                <input type="hidden" asp-for="MaxBookings" />
                                <input type="hidden" asp-for="PTSessions" />
                                <input type="hidden" asp-for="Benefits" />
                                <input type="hidden" asp-for="Description" />
                                <input type="hidden" asp-for="IncludesGymAccess" />
                                <input type="hidden" asp-for="IncludesInbody" />

                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                <!-- Payment Method Selection -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold">Select Payment Method</label>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="payment-method-card selected" id="cardMethod" onclick="selectPaymentMethod('Card')">
                                                <div class="text-center">
                                                    <div class="method-icon"><i class="fas fa-credit-card"></i></div>
                                                    <div class="method-name">Credit / Debit Card</div>
                                                    <div class="method-desc">Visa, Mastercard</div>
                                                </div>
                                                <div class="text-center mt-2">
                                                    <input type="radio" name="PaymentMethod" value="Card" checked />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="payment-method-card" id="qrMethod" onclick="selectPaymentMethod('QR')">
                                                <div class="text-center">
                                                    <div class="method-icon"><i class="fas fa-qrcode"></i></div>
                                                    <div class="method-name">QR Code</div>
                                                    <div class="method-desc">Scan to pay</div>
                                                </div>
                                                <div class="text-center mt-2">
                                                    <input type="radio" name="PaymentMethod" value="QR" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            <div class="form-group mb-3">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="autoRenew" name="AutoRenew" value="true" checked />
                                    <label class="form-check-label" for="autoRenew">
                                        <i class="fas fa-sync-alt me-1"></i>
                                        Enable Auto-Renewal
                                        <small class="text-muted d-block">
                                            Your subscription will automatically renew on the expiry date.
                                            You can cancel anytime.
                                        </small>
                                    </label>
                                </div>
                            </div>

                                <!-- Card Details -->
                                <div id="cardDetails">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="mb-3">
                                                <label asp-for="CardNumber" class="form-label fw-bold"></label>
                                                <div class="card-input">
                                                    <input asp-for="CardNumber" class="form-control" placeholder="1234 5678 9012 3456" maxlength="19" />
                                                    <span class="card-icon"><i class="fas fa-credit-card"></i></span>
                                                </div>
                                                <span asp-validation-for="CardNumber" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label asp-for="CardholderName" class="form-label fw-bold"></label>
                                                <input asp-for="CardholderName" class="form-control" placeholder="John Doe" />
                                                <span asp-validation-for="CardholderName" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label asp-for="ExpiryDate" class="form-label fw-bold"></label>
                                                <input asp-for="ExpiryDate" class="form-control" placeholder="MM/YY" maxlength="5" />
                                                <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label asp-for="CVV" class="form-label fw-bold"></label>
                                                <input asp-for="CVV" class="form-control" placeholder="123" maxlength="3" type="password" />
                                                <span asp-validation-for="CVV" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <button type="submit" class="btn btn-success btn-lg">
                                            <i class="fas fa-check me-2"></i>Confirm Payment
                                        </button>
                                    </div>
                                </div>

                                <!-- QR Code Details -->
                                <div id="qrDetails" style="display: none;">
                                    <div class="text-center py-4">
                                        <div class="alert alert-info">
                                            <i class="fas fa-info-circle me-2"></i>
                                            Click the button below to scan QR code using your camera
                                        </div>

                                        <div class="bg-white p-4 d-inline-block border rounded">
                                            <i class="fas fa-qrcode" style="font-size: 120px; color: #4F6EF7;"></i>
                                        </div>

                                        <div class="mt-3">
                                            <a asp-action="QRPaymentScan" class="btn btn-primary btn-lg">
                                                <i class="fas fa-camera me-2"></i>Scan QR Code
                                            </a>
                                        </div>

                                        <p class="mt-3 text-muted small">
                                            <i class="fas fa-info-circle me-1"></i>
                                            Open the QR code scanner app on your phone or use your computer camera
                                            <br />
                                            Amount: <strong>RM @Model.Price.ToString("F2")</strong>
                                        </p>
                                    </div>
                                </div>

                                <div class="d-grid gap-2 mt-3">
                                    <a asp-action="MemberPlans" class="btn btn-outline-secondary">
                                        <i class="fas fa-arrow-left me-2"></i>Cancel
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Payment Method Selection
        function selectPaymentMethod(method) {
            // Update UI
            document.querySelectorAll('.payment-method-card').forEach(el => el.classList.remove('selected'));
            document.querySelectorAll('.payment-method-card input[type="radio"]').forEach(el => el.checked = false);

            if (method === 'Card') {
                document.getElementById('cardMethod').classList.add('selected');
                document.querySelector('#cardMethod input[type="radio"]').checked = true;
                document.getElementById('cardDetails').style.display = 'block';
                document.getElementById('qrDetails').style.display = 'none';
            } else {
                document.getElementById('qrMethod').classList.add('selected');
                document.querySelector('#qrMethod input[type="radio"]').checked = true;
                document.getElementById('cardDetails').style.display = 'none';
                document.getElementById('qrDetails').style.display = 'block';
            }
        }

        // Card Number Formatting
        document.getElementById('CardNumber')?.addEventListener('input', function(e) {
            let value = this.value.replace(/\D/g, '');
            if (value.length > 16) value = value.slice(0, 16);
            let formatted = '';
            for (let i = 0; i < value.length; i++) {
                if (i > 0 && i % 4 === 0) formatted += ' ';
                formatted += value[i];
            }
            this.value = formatted;
        });

        // Expiry Date Formatting
        document.getElementById('ExpiryDate')?.addEventListener('input', function(e) {
            let value = this.value.replace(/\D/g, '');
            if (value.length > 4) value = value.slice(0, 4);
            if (value.length >= 2) {
                value = value.slice(0, 2) + '/' + value.slice(2);
            }
            this.value = value;
        });

        // CVV - only numbers
        document.getElementById('CVV')?.addEventListener('input', function(e) {
            this.value = this.value.replace(/\D/g, '').slice(0, 3);
        });
    </script>
}