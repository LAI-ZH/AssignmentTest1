@model IEnumerable<AssignmentTest1.Models.Entities.MembershipPlan>

@{
    ViewData["Title"] = "Membership Plans";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .page-header h2 { margin: 0; }
    .plan-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border-top: 4px solid #4F6EF7;
        height: 100%;
    }
    .plan-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }
    .plan-card .plan-price {
        font-size: 28px;
        font-weight: 600;
        color: #1A1A2E;
    }
    .plan-card .plan-price small {
        font-size: 14px;
        font-weight: 400;
        color: #6B7280;
    }
    .plan-card .plan-meta {
        font-size: 13px;
        color: #6B7280;
    }
    .plan-card .plan-meta i {
        width: 18px;
        color: #4F6EF7;
    }
    .plan-card .benefits-list {
        list-style: none;
        padding: 0;
        margin: 0.75rem 0;
    }
    .plan-card .benefits-list li {
        font-size: 13px;
        padding: 0.25rem 0;
        color: #1A1A2E;
    }
    .plan-card .benefits-list li i {
        color: #22C55E;
        margin-right: 8px;
    }
    .badge-current {
        background: #E6F1FB;
        color: #185FA5;
    }
    .btn-subscribe {
        border-radius: 20px;
        padding: 0.5rem 2rem;
    }
</style>

<div class="container mt-4">
    <div class="page-header">
        <h2><i class="fas fa-crown me-2"></i>Membership Plans</h2>
        @if (ViewBag.CurrentSubscription != null)
        {
            <span class="badge badge-current">Current: @ViewBag.CurrentSubscription.Plan?.PlanName</span>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var item in Model.OrderBy(p => p.DisplayOrder))
            {
                var isCurrent = ViewBag.CurrentSubscription != null && ViewBag.CurrentSubscription.PlanId == item.PlanId;
                <div class="col-md-4 mb-4">
                    <div class="card plan-card shadow-sm @(isCurrent ? "border-primary" : "")">
                        <div class="card-body d-flex flex-column">
                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title">@item.PlanName</h5>
                                @if (isCurrent)
                                {
                                    <span class="badge badge-current">Current Plan</span>
                                }
                            </div>

                            <!-- Price -->
                            <div class="plan-price">
                                RM @item.Price.ToString("F2")
                                <small>/ @item.DurationDays days</small>
                            </div>

                            <!-- Meta Info -->
                            <div class="mt-2">
                                <div class="plan-meta">
                                    <i class="fas fa-calendar-alt"></i>
                                    @if (item.MaxBookings == 0)
                                    {
                                        <span>Unlimited classes</span>
                                    }
                                    else
                                    {
                                        <span>@item.MaxBookings classes</span>
                                    }
                                </div>
                                @if (item.PTSessions > 0)
                                {
                                    <div class="plan-meta">
                                        <i class="fas fa-user-tie"></i>
                                        @item.PTSessions private sessions
                                    </div>
                                }
                            </div>

                            <!-- Description -->
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p class="text-muted small mt-2">@item.Description</p>
                            }

                            <!-- Benefits -->
                            @if (!string.IsNullOrEmpty(item.Benefits))
                            {
                                <ul class="benefits-list">
                                    @foreach (var benefit in item.Benefits.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <li><i class="fas fa-check-circle"></i>@benefit.Trim()</li>
                                    }
                                </ul>
                            }
                        </div>

                        <!-- Actions -->
                        <div class="card-footer bg-transparent">
                            @if (isCurrent)
                            {
                                <a asp-action="MySubscription" class="btn btn-outline-primary btn-subscribe w-100">
                                    <i class="fas fa-user-check me-2"></i>My Subscription
                                </a>
                            }
                            else if (ViewBag.CurrentSubscription != null)
                            {
                                <button class="btn btn-secondary btn-subscribe w-100" disabled>
                                    <i class="fas fa-lock me-2"></i>Already Subscribed
                                </button>
                            }
                            else
                            {
                                <a asp-action="Subscribe" asp-route-id="@item.PlanId" class="btn btn-primary btn-subscribe w-100">
                                    <i class="fas fa-shopping-cart me-2"></i>Subscribe Now
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-crown fa-3x text-muted mb-3"></i>
            <p class="text-muted">No membership plans available at the moment.</p>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}