@model IEnumerable<AssignmentTest1.Models.Entities.MembershipPlan>

@{
    ViewData["Title"] = "Membership Plans";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

        .page-header h2 {
            margin: 0;
        }

    .badge-active {
        background: #EAF3DE;
        color: #3B6D11;
    }

    .badge-inactive {
        background: #FCEBEB;
        color: #A32D2D;
    }

    .badge-unlimited {
        background: #E6F1FB;
        color: #185FA5;
    }

    .badge-inbody {
        background: #FFF3CD;
        color: #856404;
    }

    .badge-gym {
        background: #EAF3DE;
        color: #3B6D11;
    }

    .badge-pt {
        background: #FCEBEB;
        color: #A32D2D;
    }

    .plan-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border-top: 4px solid #4F6EF7;
        height: 100%;
    }

        .plan-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        }

        .plan-card .plan-price {
            font-size: 28px;
            font-weight: 600;
            color: #1A1A2E;
        }

            .plan-card .plan-price small {
                font-size: 14px;
                font-weight: 400;
                color: #6B7280;
            }

        .plan-card .plan-meta {
            font-size: 13px;
            color: #6B7280;
        }

            .plan-card .plan-meta i {
                width: 18px;
                color: #4F6EF7;
            }

        .plan-card .benefits-list {
            list-style: none;
            padding: 0;
            margin: 0.75rem 0;
        }

            .plan-card .benefits-list li {
                font-size: 13px;
                padding: 0.25rem 0;
                color: #1A1A2E;
            }

                .plan-card .benefits-list li i {
                    color: #22C55E;
                    margin-right: 8px;
                }

        .plan-card .excludes-text {
            font-size: 12px;
            color: #DC3545;
        }

        .plan-card .loyalty-text {
            font-size: 12px;
            color: #6B7280;
        }

    .plan-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 0.5rem;
    }

        .plan-tags .badge {
            font-size: 10px;
            padding: 2px 8px;
        }

    .table-action {
        display: flex;
        gap: 5px;
    }

        .table-action .btn {
            padding: 0.2rem 0.5rem;
            font-size: 13px;
        }

    .subscriber-stats {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-top: 0.5rem;
    }

        .subscriber-stats .stat-item {
            font-size: 13px;
            color: #6B7280;
        }

            .subscriber-stats .stat-item strong {
                color: #1A1A2E;
            }

    .btn-view-subscribers {
        font-size: 12px;
        padding: 4px 12px;
        border-radius: 20px;
        border: 1px solid #4F6EF7;
        color: #4F6EF7;
        background: transparent;
        transition: all 0.2s;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }

        .btn-view-subscribers:hover {
            background: #4F6EF7;
            color: white;
            text-decoration: none;
        }
</style>

<div class="container mt-4">
    <div class="page-header">
        <h2><i class="fas fa-crown me-2"></i>Membership Plans</h2>
        <div class="d-flex gap-2">
            <a asp-action="ChoosePlanType" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Create Plan
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var item in Model.OrderBy(p => p.DisplayOrder))
            {
                var activeCount = item.Subscriptions?.Count(s => s.Status == "Active") ?? 0;
                var totalCount = item.Subscriptions?.Count ?? 0;

                <div class="col-md-4 mb-4">
                    <div class="card plan-card shadow-sm @(!item.IsActive ? "opacity-75" : "")">
                        <div class="card-body d-flex flex-column">
                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title">@item.PlanName</h5>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive">Inactive</span>
                                }
                            </div>

                            <!-- Price -->
                            <div class="plan-price">
                                RM @item.Price.ToString("F2")
                                @if (item.DurationDays > 0)
                                {
                                    <small>/ @item.DurationDays days</small>
                                }
                                else
                                {
                                    <small>No expiry</small>
                                }
                            </div>

                            <!-- Meta Info -->
                            <div class="mt-2">
                                <div class="plan-meta">
                                    <i class="fas fa-calendar-alt"></i>
                                    @if (item.MaxBookings == 0)
                                    {
                                        <span>Unlimited classes</span>
                                    }
                                    else
                                    {
                                        <span>@item.MaxBookings classes</span>
                                    }
                                </div>
                                @if (item.PTSessions > 0)
                                {
                                    <div class="plan-meta">
                                        <i class="fas fa-user-tie"></i>
                                        @item.PTSessions private sessions
                                    </div>
                                }
                            </div>

                            <!-- Tags / Badges -->
                            <div class="plan-tags">
                                @if (item.MaxBookings == 0)
                                {
                                    <span class="badge badge-unlimited">♾️ Unlimited</span>
                                }
                                @if (item.IncludesInbody)
                                {
                                    <span class="badge badge-inbody">⚖️ Inbody Test</span>
                                }
                                @if (item.IncludesGymAccess)
                                {
                                    <span class="badge badge-gym">🏋️ Gym Access</span>
                                }
                                @if (item.PTSessions > 0)
                                {
                                    <span class="badge badge-pt">💪 @item.PTSessions PT</span>
                                }
                            </div>

                            <!-- Description -->
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p class="text-muted small mt-2">@item.Description</p>
                            }

                            <!-- Excludes -->
                            @if (!string.IsNullOrEmpty(item.Excludes))
                            {
                                <p class="excludes-text small mt-1">
                                    <i class="fas fa-ban me-1"></i>Excludes: @item.Excludes
                                </p>
                            }

                            <!-- Loyalty Discount -->
                            @if (!string.IsNullOrEmpty(item.LoyaltyDiscount))
                            {
                                <div class="loyalty-text small mt-1">
                                    <i class="fas fa-gift me-1"></i>
                                    @foreach (var line in item.LoyaltyDiscount.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <div>• @line.Trim()</div>
                                    }
                                </div>
                            }

                            <!-- Benefits -->
                            @if (!string.IsNullOrEmpty(item.Benefits))
                            {
                                <ul class="benefits-list">
                                    @foreach (var benefit in item.Benefits.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <li><i class="fas fa-check-circle"></i>@benefit.Trim()</li>
                                    }
                                </ul>
                            }

                            <!-- Subscriber Stats -->
                            <div class="subscriber-stats">
                                <span class="stat-item">
                                    <strong>@activeCount</strong> active
                                </span>
                                <span class="stat-item">
                                    <strong>@totalCount</strong> total
                                </span>
                                @if (totalCount > 0)
                                {
                                    <a asp-action="PlanSubscribers" asp-route-id="@item.PlanId" class="btn-view-subscribers">
                                        <i class="fas fa-users me-1"></i>View Subscribers
                                    </a>
                                }
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="card-footer bg-transparent">
                            <div class="d-flex gap-2">
                                <a asp-action="EditPlan" asp-route-id="@item.PlanId" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <button type="button" class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal"
                                        data-id="@item.PlanId" data-name="@item.PlanName">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-crown fa-3x text-muted mb-3"></i>
            <p class="text-muted">No membership plans found.</p>
            <a asp-action="ChoosePlanType" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Create Your First Plan
            </a>
        </div>
    }
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete plan <strong id="deletePlanName"></strong>?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="DeletePlan" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deletePlanId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Populate delete modal
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function(event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            document.getElementById('deletePlanId').value = id;
            document.getElementById('deletePlanName').textContent = name;
        });
    </script>
}