@{
    ViewData["Title"] = "Payment Success";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <i class="fas fa-check-circle text-success" style="font-size: 72px;"></i>
                    </div>

                    <h2 class="text-success">Payment Successful! 🎉</h2>
                    <p class="text-muted">Your subscription has been activated.</p>

                    <div class="mt-4 text-start">
                        <div class="row">
                            <div class="col-sm-6">
                                <p><strong>Plan:</strong> @ViewBag.PlanName</p>
                                <p><strong>Amount:</strong> RM @ViewBag.Amount?.ToString("F2")</p>
                            </div>
                            <div class="col-sm-6">
                                <p><strong>Transaction ID:</strong></p>
                                <p class="text-muted small">@ViewBag.TransactionId</p>
                                <p><strong>Date:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                                <!-- ✅ Expiry Date -->
                                @if (ViewBag.ExpiryDate != null)
                                {
                                    <p><strong>Expiry Date:</strong></p>
                                    <p class="text-danger fw-bold">@ViewBag.ExpiryDate</p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <a asp-action="DownloadReceipt" asp-route-id="@ViewBag.PaymentId" class="btn btn-primary btn-lg">
                            <i class="fas fa-file-pdf me-2"></i>Download Receipt (PDF)
                        </a>

                        <a asp-action="MySubscription" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-user-check me-2"></i>View My Subscription
                        </a>

                        <a asp-action="MemberPlans" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Back to Plans
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>