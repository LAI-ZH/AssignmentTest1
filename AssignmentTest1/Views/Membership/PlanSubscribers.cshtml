@model AssignmentTest1.Models.Entities.MembershipPlan

@{
    ViewData["Title"] = $"Subscribers - {Model.PlanName}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

        .page-header h2 {
            margin: 0;
        }

    .badge-active {
        background: #EAF3DE;
        color: #3B6D11;
    }

    .badge-cancelled {
        background: #FCEBEB;
        color: #A32D2D;
    }

    .badge-expired {
        background: #FFF3CD;
        color: #856404;
    }

    .table-action .btn {
        padding: 0.2rem 0.5rem;
        font-size: 13px;
    }
</style>

<div class="container mt-4">
    <div class="page-header">
        <h2><i class="fas fa-crown me-2"></i>Subscribers - @Model.PlanName</h2>
        <div>
            <span class="badge bg-success me-2">Active: @(Model.Subscriptions?.Count(s => s.Status == "Active") ?? 0)</span>
            <span class="badge bg-secondary">Total: @(Model.Subscriptions?.Count ?? 0)</span>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Member</th>
                            <th>Email</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th>Bookings Used</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Subscriptions != null && Model.Subscriptions.Any())
                        {
                            @foreach (var sub in Model.Subscriptions.OrderByDescending(s => s.StartDate))
                            {
                                <tr>
                                    <td><i class="fas fa-user-circle me-1"></i>@sub.User?.FullName</td>
                                    <td>@sub.User?.Email</td>
                                    <td>@sub.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@sub.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (sub.Status == "Active")
                                        {
                                            <span class="badge badge-active">Active</span>
                                        }
                                        else if (sub.Status == "Cancelled")
                                        {
                                            <span class="badge badge-cancelled">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-expired">@sub.Status</span>
                                        }
                                    </td>
                                    <td>@sub.BookingsUsed / @(sub.Plan?.MaxBookings == 0 ? "∞" : sub.Plan?.MaxBookings.ToString())</td>
                                    <td>
                                        <div class="table-action">
                                            <a asp-controller="User" asp-action="Details" asp-route-id="@sub.UserId" class="btn btn-sm btn-info" title="View User">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-3">No subscribers for this plan.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <a asp-action="Plans" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Plans
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}