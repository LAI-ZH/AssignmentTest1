@{
    ViewData["Title"] = "Access Denied - FitBook";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-danger">
                <div class="card-header bg-danger text-white text-center py-3">
                    <h4><i class="fas fa-exclamation-triangle me-2"></i>Access Denied</h4>
                </div>
                <div class="card-body p-4">
                    <i class="fas fa-lock text-danger" style="font-size: 80px;"></i>
                    <h3 class="mt-3">You don't have permission to access this page.</h3>
                    <p class="text-muted">Please contact an administrator if you believe this is an error.</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="fas fa-home me-2"></i>Return to Home
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
                            <i class="fas fa-sign-in-alt me-2"></i>Login with different account
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>