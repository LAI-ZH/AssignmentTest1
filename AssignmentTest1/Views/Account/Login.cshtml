@model AssignmentTest1.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login - FitBook";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4><i class="fas fa-sign-in-alt me-2"></i>Login to FitBook</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control form-control-lg" placeholder="Enter your email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold"></label>
                            <div class="password-toggle">
                                <input asp-for="Password" class="form-control form-control-lg" placeholder="Enter your password" id="loginPassword" />
                                <button type="button" class="toggle-icon" id="toggleLoginPassword" tabindex="-1">
                                    <i class="fas fa-eye" id="loginEyeIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>

                        <!-- 验证码 -->
                        <div class="mb-3" id="captchaSection" style="display:none;">
                            <label class="form-label fw-bold">Enter Captcha</label>
                            <div class="row g-2">
                                <div class="col-8">
                                    <input type="text" id="CaptchaInput" class="form-control" placeholder="Enter the code above" />
                                </div>
                                <div class="col-4">
                                    <img id="captchaImage" src="@Url.Action("GetCaptcha", "Account")" alt="Captcha" style="height:38px; border-radius:6px; cursor:pointer;" onclick="refreshCaptcha()" />
                                </div>
                            </div>
                            <span class="text-muted small">Click the image to refresh</span>
                            <input type="hidden" name="CaptchaCode" id="CaptchaCode" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-sign-in-alt me-2"></i>Login
                            </button>
                        </div>
                    </form>

                    <hr />

                    <div class="text-center">
                        <p>Don't have an account? <a asp-action="Register" class="text-primary fw-bold">Register here</a></p>
                        <p><a asp-action="ForgotPassword">Forgot your password?</a></p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script>
    // Login password toggle
    document.getElementById('toggleLoginPassword').addEventListener('click', function() {
        var passwordInput = document.getElementById('loginPassword');
        var eyeIcon = document.getElementById('loginEyeIcon');

        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            eyeIcon.className = 'fas fa-eye-slash';
        } else {
            passwordInput.type = 'password';
            eyeIcon.className = 'fas fa-eye';
        }
    });

    // ============================================================
    // Captcha Functions
    // ============================================================

    let loginAttempts = 0;

    // 登录失败时显示验证码
    function showCaptcha() {
        document.getElementById('captchaSection').style.display = 'block';
        refreshCaptcha();
    }

    function refreshCaptcha() {
        document.getElementById('captchaImage').src = '@Url.Action("GetCaptcha", "Account")?' + new Date().getTime();
    }

    // 验证码输入同步
    document.getElementById('CaptchaInput')?.addEventListener('input', function() {
        document.getElementById('CaptchaCode').value = this.value;
    });

    document.getElementById('loginForm').addEventListener('submit', function(e) {
        var captchaSection = document.getElementById('captchaSection');
        if (captchaSection && captchaSection.style.display !== 'none') {
            var captchaInput = document.getElementById('CaptchaInput').value;
            if (!captchaInput || captchaInput.length < 4) {
                alert('Please enter the captcha code.');
                e.preventDefault();
                return;
            }
        }
    });
</script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />