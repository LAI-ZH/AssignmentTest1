@model AssignmentTest1.Models.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login - FitBook";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - FitBook</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Login.css" />
</head>
<body>

<div class="login-container">
    <div class="login-card">

        <div class="login-header">
            <h2><i class="fas fa-dumbbell"></i> FitBook</h2>
        </div>

        <div class="login-body">

            @if (TempData["Success"] != null)
            {
                <div class="login-message success">@TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="login-message error">@TempData["Error"]</div>
            }

            <form method="post" action="/Account/Login" class="login-form">



                <div class="login-form-group">
                    <label for="Email"><i class="fas fa-envelope"></i> Email Address</label>
                    <input type="email" id="Email" name="Email" class="login-input" placeholder="you@example.com" value="@Model?.Email" />
                    <span class="field-validation-error">@Html.ValidationMessageFor(m => m.Email)</span>
                </div>

                <div class="login-form-group">
                    <label for="Password"><i class="fas fa-lock"></i> Password</label>
                    <div class="password-wrapper">
                        <input type="password" id="Password" name="Password" class="login-input" placeholder="Enter your password" id="loginPassword" />
                        <button type="button" class="password-toggle" onclick="togglePassword()">
                            <i class="fas fa-eye" id="loginEyeIcon"></i>
                        </button>
                    </div>
                    <span class="field-validation-error">@Html.ValidationMessageFor(m => m.Password)</span>
                </div>

                <div class="remember-row">
                    <input type="checkbox" id="RememberMe" name="RememberMe" value="true" />
                    <label for="RememberMe">Remember me</label>
                </div>

                <div id="captchaSection" style="display: none;" class="login-form-group">
                    <label>Enter Captcha</label>
                    <div style="display:flex; gap:10px;">
                        <input type="text" id="CaptchaCode" name="CaptchaCode" class="login-input" placeholder="Enter the code" style="flex:1;" />
                        <img id="captchaImage" src="@Url.Action("GetCaptcha", "Account")" alt="Captcha" style="height:50px; border-radius:8px; cursor:pointer;" onclick="refreshCaptcha()" />
                    </div>
                    <span class="field-validation-error" style="font-size:11px; color:#7a8fa8;">Click the image to refresh</span>
                </div>

                <button type="submit" class="login-button">
                    <i class="fas fa-sign-in-alt"></i> Sign In
                </button>
            </form>

            <div class="login-divider"></div>

            <div class="register-text">
                Don't have an account? <a href="/Account/Register">Create one now</a>
            </div>

            <a href="/Account/ForgotPassword" class="forgot-password">
                <i class="fas fa-key"></i> Forgot password?
            </a>
        </div>
    </div>
</div>

<script>
    function togglePassword() {
        var input = document.getElementById('Password');
        var icon = document.getElementById('loginEyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'fas fa-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'fas fa-eye';
        }
    }

    function refreshCaptcha() {
        document.getElementById('captchaImage').src = '@Url.Action("GetCaptcha", "Account")?' + new Date().getTime();
    }

    // Captcha 显示逻辑（假设后台传了 FailedAttempts）
    @if (Model != null && Model.FailedAttempts >= 3)
    {
        <text>
            document.getElementById('captchaSection').style.display = 'block';
            refreshCaptcha();
        </text>
    }
</script>

</body>
</html>