@model AssignmentTest1.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register - FitBook";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Register.css" />
</head>
<body>

    <div class="register-card">
        <!-- Header -->
        <div class="register-header">
            <h1>
                <i class="fas fa-dumbbell"></i> FitBook
            </h1>
            <p><i class="fas fa-rocket" style="margin-right:6px;"></i> Start your fitness journey today</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" style="padding:0.75rem 1rem; border-radius:12px; background:#FEF2F2; color:#991B1B; border:0.5px solid #FECACA; margin-bottom:1.25rem;">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            </div>
        }

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { enctype = "multipart/form-data", @class = "register-form" }))
        {
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="padding:0.75rem 1rem; border-radius:12px; background:#FEF2F2; color:#991B1B; border:0.5px solid #FECACA; margin-bottom:1.25rem;"></div>

            <!-- Full Name -->
            <div class="form-group">
                <label for="FullName"><i class="fas fa-user"></i> Full Name</label>
                <div class="input-wrapper">
                    <i class="fas fa-user"></i>
                    <input asp-for="FullName" placeholder="Enter your full name" />
                </div>
                <span asp-validation-for="FullName" class="text-danger" style="font-size:0.8rem; color:#DC3545;"></span>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label for="Email"><i class="fas fa-envelope"></i> Email Address</label>
                <div class="input-wrapper">
                    <i class="fas fa-envelope"></i>
                    <input asp-for="Email" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger" style="font-size:0.8rem; color:#DC3545;"></span>
            </div>

            <!-- Gender -->
            <div class="form-group">
                <label for="Gender"><i class="fas fa-venus-mars"></i> Gender</label>
                <div class="input-wrapper">
                    <i class="fas fa-venus-mars"></i>
                    <select asp-for="Gender">
                        <option value="">Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <span asp-validation-for="Gender" class="text-danger" style="font-size:0.8rem; color:#DC3545;"></span>
            </div>

            <!-- Phone -->
            <div class="form-group">
                <label for="Phone"><i class="fas fa-phone"></i> Phone Number</label>
                <div class="input-wrapper">
                    <i class="fas fa-phone"></i>
                    <input asp-for="Phone" placeholder="012-3456789" />
                </div>
                <span asp-validation-for="Phone" class="text-danger" style="font-size:0.8rem; color:#DC3545;"></span>
            </div>

            <!-- Profile Photo -->
            <div class="form-group">
                <label for="ProfilePhoto"><i class="fas fa-image"></i> Profile Photo</label>
                <div class="photo-upload">
                    <span class="file-label">
                        <i class="fas fa-camera"></i> Upload photo
                    </span>
                    <div class="custom-file-input">
                        <span class="file-name" id="file-name-display">No file chosen</span>
                        <button type="button" class="file-picker-btn" id="browseBtn">
                            <i class="fas fa-folder-open" style="margin-right:4px;"></i> Browse
                        </button>
                        <input type="file" id="profilePhotoInput" asp-for="ProfilePhoto" accept="image/*" style="display:none;" />
                    </div>
                </div>
                <div class="photo-hint">
                    <i class="fas fa-info-circle" style="margin-right:4px;"></i> JPG, PNG, GIF (max 5MB)
                </div>
                <span asp-validation-for="ProfilePhoto" class="text-danger" style="font-size:0.8rem; color:#DC3545;"></span>
            </div>

            <!-- Password with toggle -->
            <div class="form-group">
                <label for="Password"><i class="fas fa-lock"></i> Password</label>
                <div class="input-wrapper" style="position:relative;">
                    <i class="fas fa-lock"></i>
                    <input asp-for="Password" placeholder="Min 6 characters" id="registerPassword" />
                    <button type="button" id="toggleRegisterPassword" style="position:absolute; right:16px; background:transparent; border:none; cursor:pointer; color:#7a8fa8; padding:0; z-index:2;">
                        <i class="fas fa-eye" id="registerEyeIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger" style="font-size:0.8rem; color:#DC3545;"></span>
            </div>

            <!-- Confirm Password with toggle -->
            <div class="form-group">
                <label for="ConfirmPassword"><i class="fas fa-check-circle"></i> Confirm Password</label>
                <div class="input-wrapper" style="position:relative;">
                    <i class="fas fa-check-circle"></i>
                    <input asp-for="ConfirmPassword" placeholder="Confirm your password" id="registerConfirmPassword" />
                    <button type="button" id="toggleRegisterConfirmPassword" style="position:absolute; right:16px; background:transparent; border:none; cursor:pointer; color:#7a8fa8; padding:0; z-index:2;">
                        <i class="fas fa-eye" id="registerConfirmEyeIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.8rem; color:#DC3545;"></span>
            </div>

            <div class="register-action">
                <button type="submit" class="btn-register">
                    <i class="fas fa-user-plus"></i> Create Account
                </button>
            </div>
        }

        <div class="login-link">
            <i class="fas fa-arrow-left" style="font-size:0.75rem;"></i>
            Already have an account?
            <a asp-action="Login">Sign In</a>
        </div>
    </div>

    <!-- All JavaScript here -->
    <script>
            // Wait for DOM to be fully loaded
            document.addEventListener('DOMContentLoaded', function() {

                // 1. Password toggle
                const togglePasswordBtn = document.getElementById('toggleRegisterPassword');
                const passwordInput = document.getElementById('registerPassword');
                const passwordIcon = document.getElementById('registerEyeIcon');

                if (togglePasswordBtn && passwordInput && passwordIcon) {
                    togglePasswordBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        if (passwordInput.type === 'password') {
                            passwordInput.type = 'text';
                            passwordIcon.className = 'fas fa-eye-slash';
                        } else {
                            passwordInput.type = 'password';
                            passwordIcon.className = 'fas fa-eye';
                        }
                    });
                }

                // 2. Confirm Password toggle
                const toggleConfirmBtn = document.getElementById('toggleRegisterConfirmPassword');
                const confirmInput = document.getElementById('registerConfirmPassword');
                const confirmIcon = document.getElementById('registerConfirmEyeIcon');

                if (toggleConfirmBtn && confirmInput && confirmIcon) {
                    toggleConfirmBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        if (confirmInput.type === 'password') {
                            confirmInput.type = 'text';
                            confirmIcon.className = 'fas fa-eye-slash';
                        } else {
                            confirmInput.type = 'password';
                            confirmIcon.className = 'fas fa-eye';
                        }
                    });
                }

                // 3. File upload - Browse button
                const browseBtn = document.getElementById('browseBtn');
                const fileInput = document.getElementById('profilePhotoInput');
                const fileNameDisplay = document.getElementById('file-name-display');

                if (browseBtn && fileInput) {
                    browseBtn.addEventListener('click', function() {
                        fileInput.click();
                    });
                }

                if (fileInput && fileNameDisplay) {
                    fileInput.addEventListener('change', function() {
                        if (this.files && this.files.length > 0) {
                            fileNameDisplay.textContent = this.files[0].name;
                        } else {
                            fileNameDisplay.textContent = 'No file chosen';
                        }
                    });
                }
            });
    </script>

    @* Validation Scripts *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>