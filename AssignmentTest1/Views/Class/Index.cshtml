@model IEnumerable<AssignmentTest1.Models.Entities.FitnessClass>

@{
    ViewData["Title"] = "Manage Classes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .page-header h2 { margin: 0; }
    .badge-active { background: #EAF3DE; color: #3B6D11; }
    .badge-inactive { background: #FCEBEB; color: #A32D2D; }
    .badge-schedules { background: #E6F1FB; color: #185FA5; }
    .table-action { display: flex; gap: 5px; flex-wrap: wrap; }
    .table-action .btn { padding: 0.2rem 0.5rem; font-size: 13px; }
    .class-card-admin {
        border-left: 4px solid #4F6EF7;
    }
</style>

<div class="container mt-4">
    <div class="page-header">
        <h2><i class="fas fa-dumbbell me-2"></i>Manage Classes</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Create New Class
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Class Name</th>
                            <th>Category</th>
                            <th>Trainer</th>
                            <th>Capacity</th>
                            <th>Schedules</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ClassId</td>
                                <td><strong>@item.ClassName</strong></td>
                                <td><span class="badge bg-secondary">@item.Category</span></td>
                                <td>@(item.Trainer?.FullName ?? "Not assigned")</td>
                                <td>@item.MaxCapacity</td>
                                <td>
                                    <span class="badge badge-schedules">@(item.Schedules?.Count ?? 0)</span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactive">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-action">
                                        <a asp-action="Details" asp-route-id="@item.ClassId" class="btn btn-sm btn-info" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.ClassId" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" title="Delete"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                data-id="@item.ClassId" data-name="@item.ClassName">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-dumbbell fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No classes found. <a asp-action="Create">Create your first class</a>.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete class <strong id="deleteClassName"></strong>?</p>
                <p class="text-muted small">This action cannot be undone. All schedules for this class will also be affected.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteClassId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Populate delete modal
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            document.getElementById('deleteClassId').value = id;
            document.getElementById('deleteClassName').textContent = name;
        });
    </script>
}