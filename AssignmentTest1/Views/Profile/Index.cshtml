@model AssignmentTest1.Models.ViewModels.UserProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .profile-card {
        max-width: 600px;
        margin: 0 auto;
    }
    .avatar-circle {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: #4F6EF7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        color: white;
        margin: 0 auto 1rem;
    }
    .detail-row {
        display: flex;
        padding: 0.5rem 0;
        border-bottom: 0.5px solid #F3F4F6;
    }
    .detail-label {
        width: 120px;
        font-weight: 500;
        color: #6B7280;
    }
    .detail-value {
        flex: 1;
        color: #1A1A2E;
    }
    .badge-role {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 99px;
        font-size: 12px;
        font-weight: 500;
    }
    .badge-role.admin { background: #FCEBEB; color: #A32D2D; }
    .badge-role.trainer { background: #E6F1FB; color: #185FA5; }
    .badge-role.member { background: #EAF3DE; color: #3B6D11; }
</style>

<div class="container mt-4">
    <div class="profile-card">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4><i class="fas fa-user-circle me-2"></i>My Profile</h4>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Avatar -->
                <div class="text-center">
                    <div class="avatar-circle">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                    <h5 class="mt-2">@Model.FullName</h5>
                    <span class="badge-role @Model.Gender?.ToLower()">
                        @if (Model.Gender == "Male")
                        {
                            <i class="fas fa-mars"></i>
                        }
                        else if (Model.Gender == "Female")
                        {

                            <i class="fas fa-venus"></i>
                        }
                        @Model.Gender
                    </span>
                    <span class="badge-role @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToLower()">
                        @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                    </span>
                </div>

                <hr />

                <!-- Details -->
                <div class="detail-row">
                    <span class="detail-label">Full Name</span>
                    <span class="detail-value">@Model.FullName</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Email</span>
                    <span class="detail-value">@Model.Email</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Phone</span>
                    <span class="detail-value">@(Model.Phone ?? "Not provided")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Gender</span>
                    <span class="detail-value">@(Model.Gender ?? "Not specified")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Role</span>
                    <span class="detail-value">
                        <span class="badge-role @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToLower()">
                            @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                        </span>
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Member Since</span>
                    <span class="detail-value">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Last Login</span>
                    <span class="detail-value">@(Model.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "Never")</span>
                </div>

                <hr />

                <!-- Actions -->
                <div class="d-grid gap-2">
                    <a asp-action="Edit" class="btn btn-primary">
                        <i class="fas fa-edit me-2"></i>Edit Profile
                    </a>
                    <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-secondary">
                        <i class="fas fa-key me-2"></i>Change Password
                    </a>
                    <a asp-controller="Dashboard" asp-action="@(User.IsInRole("Admin") ? "Index" : User.IsInRole("Trainer") ? "TrainerDashboard" : "MemberDashboard")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}