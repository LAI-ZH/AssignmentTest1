@model AssignmentTest1.Models.ViewModels.UserProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .profile-card {
        max-width: 600px;
        margin: 0 auto;
    }

    .avatar-circle {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: #4F6EF7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        color: white;
        margin: 0 auto 1rem;
    }

    .detail-row {
        display: flex;
        padding: 0.5rem 0;
        border-bottom: 0.5px solid #F3F4F6;
    }

    .detail-label {
        width: 120px;
        font-weight: 500;
        color: #6B7280;
    }

    .detail-value {
        flex: 1;
        color: #1A1A2E;
    }

    .badge-role {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 99px;
        font-size: 12px;
        font-weight: 500;
    }

        .badge-role.admin {
            background: #FCEBEB;
            color: #A32D2D;
        }

        .badge-role.trainer {
            background: #E6F1FB;
            color: #185FA5;
        }

        .badge-role.member {
            background: #EAF3DE;
            color: #3B6D11;
        }

    .profile-photo {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #4F6EF7;
        margin: 0 auto 1rem;
    }

    .membership-card {
        background: #f8fafc;
        border-radius: 12px;
        padding: 1.25rem;
        border: 1px solid #eef2f7;
        margin-top: 0.5rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 0.3rem 1rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 0.75rem;
    }

        .status-badge.active {
            background: #d1fae5;
            color: #065f46;
        }

        .status-badge.expired {
            background: #fee2e2;
            color: #991b1b;
        }

        .status-badge.cancelled {
            background: #fef3c7;
            color: #92400e;
        }

        .status-badge.no-plan {
            background: #e5e7eb;
            color: #4b5563;
        }

    .plan-info p {
        margin: 0.25rem 0;
        font-size: 0.95rem;
        color: #1f2a44;
    }

    .plan-info strong {
        color: #0b1a33;
    }
</style>

<div class="container mt-4">
    <div class="profile-card">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4><i class="fas fa-user-circle me-2"></i>My Profile</h4>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Avatar -->
                <div class="text-center">
                    @if (!string.IsNullOrEmpty(Model.ProfilePhoto))
                    {
                        <img src="@Model.ProfilePhoto" alt="Profile Photo" class="profile-photo" />
                    }
                    else
                    {
                        <div class="avatar-circle">
                            @Model.FullName.Substring(0, 1).ToUpper()
                        </div>
                    }
                    <h5 class="mt-2">@Model.FullName</h5>
                    <span class="badge-role @Model.Gender?.ToLower()">
                        @if (Model.Gender == "Male")
                        {
                            <i class="fas fa-mars"></i>
                        }
                        else if (Model.Gender == "Female")
                        {

                            <i class="fas fa-venus"></i>
                        }
                        @Model.Gender
                    </span>
                    <span class="badge-role @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToLower()">
                        @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                    </span>
                </div>

                <hr />

                <!-- Details -->
                <div class="detail-row">
                    <span class="detail-label">Full Name</span>
                    <span class="detail-value">@Model.FullName</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Email</span>
                    <span class="detail-value">@Model.Email</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Phone</span>
                    <span class="detail-value">@(Model.Phone ?? "Not provided")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Gender</span>
                    <span class="detail-value">@(Model.Gender ?? "Not specified")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Role</span>
                    <span class="detail-value">
                        <span class="badge-role @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToLower()">
                            @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                        </span>
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Member Since</span>
                    <span class="detail-value">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Last Login</span>
                    <span class="detail-value">@(Model.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "Never")</span>
                </div>
                @if (User.IsInRole("Member"))
                {
                    <!-- 在个人信息卡片下方添加 -->
                    <div class="profile-section">
                        <h5><i class="fas fa-crown me-2"></i>Membership Status</h5>
                        <div class="membership-card">
                            @if (ViewBag.MembershipStatus == "Active")
                            {
                                <div class="status-badge active">
                                    <i class="fas fa-check-circle"></i> Active
                                </div>
                                <div class="plan-info">
                                    <p><strong>Plan:</strong> @ViewBag.PlanName</p>
                                    <p><strong>Expiry Date:</strong> @(ViewBag.ExpiryDate?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                                    @{
                                        var daysLeft = ViewBag.ExpiryDate != null ? ((DateTime)ViewBag.ExpiryDate - DateTime.Now).Days : 0;
                                    }
                                    @if (daysLeft > 0)
                                    {
                                        <p><strong>Days Remaining:</strong> @daysLeft days</p>
                                    }
                                </div>
                            }
                            else if (ViewBag.MembershipStatus == "Expired")
                            {
                                <div class="status-badge expired">
                                    <i class="fas fa-exclamation-triangle"></i> Expired
                                </div>
                                <div class="plan-info">
                                    <p><strong>Plan:</strong> @ViewBag.PlanName</p>
                                    <p><strong>Expired on:</strong> @(ViewBag.ExpiryDate?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                                    <a href="/Membership/MemberPlans" class="btn btn-primary btn-sm mt-2">
                                        <i class="fas fa-sync me-1"></i> Renew Now
                                    </a>
                                </div>
                            }
                            else if (ViewBag.MembershipStatus == "Cancelled")
                            {
                                <div class="status-badge cancelled">
                                    <i class="fas fa-times-circle"></i> Cancelled
                                </div>
                                <div class="plan-info">
                                    <p><strong>Plan:</strong> @ViewBag.PlanName</p>
                                    <a href="/Membership/MemberPlans" class="btn btn-primary btn-sm mt-2">
                                        <i class="fas fa-sync me-1"></i> Subscribe Again
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="status-badge no-plan">
                                    <i class="fas fa-info-circle"></i> No Subscription
                                </div>
                                <div class="plan-info">
                                    <p>You don't have an active membership plan.</p>
                                    <a href="/Membership/MemberPlans" class="btn btn-primary btn-sm mt-2">
                                        <i class="fas fa-crown me-1"></i> View Plans
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
                <hr />

                <!-- Actions -->
                <div class="d-grid gap-2">
                    <a asp-action="Edit" class="btn btn-primary">
                        <i class="fas fa-edit me-2"></i>Edit Profile
                    </a>
                    <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-secondary">
                        <i class="fas fa-key me-2"></i>Change Password
                    </a>
                    <a asp-controller="Dashboard" asp-action="@(User.IsInRole("Admin") ? "Index" : User.IsInRole("Trainer") ? "TrainerDashboard" : "MemberDashboard")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}