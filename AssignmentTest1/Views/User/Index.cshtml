@model IEnumerable<AssignmentTest1.Models.Entities.User>

@{
    ViewData["Title"] = "Manage Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .page-header h2 { margin: 0; }
    .badge-admin { background: #FCEBEB; color: #A32D2D; }
    .badge-trainer { background: #E6F1FB; color: #185FA5; }
    .badge-member { background: #EAF3DE; color: #3B6D11; }
    .filter-section {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 1rem;
    }
    .table-action { display: flex; gap: 5px; }
    .table-action .btn { padding: 0.2rem 0.5rem; font-size: 13px; }
</style>

<div class="container mt-4">
    <div class="page-header">
        <h2><i class="fas fa-users me-2"></i>Manage Users</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-user-plus me-2"></i>Create User
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* <!-- Filter & Search -->
    <div class="filter-section">
        <form method="get" class="d-flex gap-2 flex-wrap align-items-center">
            <input type="text" name="search" class="form-control" placeholder="Search by name or email" value="@ViewBag.SearchTerm" style="width: 250px;" />
            
            <select name="role" class="form-select" style="width: 150px;">
                <option value="">All Roles</option>
                <option value="Admin" @(ViewBag.SelectedRole == "Admin" ? "selected" : "")>Admin</option>
                <option value="Trainer" @(ViewBag.SelectedRole == "Trainer" ? "selected" : "")>Trainer</option>
                <option value="Member" @(ViewBag.SelectedRole == "Member" ? "selected" : "")>Member</option>
            </select>
            
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-search me-1"></i>Filter
            </button>
            
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-undo me-1"></i>Clear
            </a>
        </form>
        
        <span class="badge bg-secondary ms-auto">@Model.Count() users</span>
    </div> *@

    <!-- User Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Gender</th>
                            <th>Role</th>
                            <th>Phone</th>
                            <th>Last Login</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.UserId</td>
                                <td><i class="fas fa-user-circle me-1"></i>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.Gender))
                                    {
                                        @if (user.Gender == "Male")
                                        {
                                            <i class="fas fa-mars text-primary"></i>
                                        }
                                        else if (user.Gender == "Female")
                                        {
                                            <i class="fas fa-venus text-danger"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-genderless text-secondary"></i>
                                        }
                                        <span class="ms-1">@user.Gender</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(user.Role == "Admin" ? "badge-admin" : user.Role == "Trainer" ? "badge-trainer" : "badge-member")">
                                        @user.Role
                                    </span>
                                </td>
                                <td>@(user.Phone ?? "-")</td>
                                <td>@(user.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "Never")</td>  <!-- ✅ 新增 -->

                                <td>
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge bg-danger">Locked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-action">
                                        <a asp-action="Details" asp-route-id="@user.UserId" class="btn btn-sm btn-info" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" title="Delete"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                data-id="@user.UserId" data-name="@user.FullName">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No users found.</p>
                    <a asp-action="Create" class="btn btn-primary">Create User</a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete user <strong id="deleteUserName"></strong>?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteUserId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            document.getElementById('deleteUserId').value = id;
            document.getElementById('deleteUserName').textContent = name;
        });
    </script>
}