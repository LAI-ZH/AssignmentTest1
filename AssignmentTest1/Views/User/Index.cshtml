@model AssignmentTest1.Models.ViewModels.UserIndexViewModel

@{
    ViewData["Title"] = "Manage Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

        .page-header h2 {
            margin: 0;
        }

    .filter-bar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 1rem;
        background: #ffffff;
        padding: 0.75rem 1.25rem;
        border-radius: 12px;
        border: 0.5px solid #E5E7EB;
    }

        .filter-bar .search-box {
            flex: 1;
            min-width: 200px;
            position: relative;
        }

            .filter-bar .search-box input {
                width: 100%;
                padding: 0.5rem 1rem 0.5rem 2.5rem;
                border: 0.5px solid #E5E7EB;
                border-radius: 8px;
                font-size: 14px;
                background: #F9FAFB;
                transition: border-color 0.2s;
            }

                .filter-bar .search-box input:focus {
                    outline: none;
                    border-color: #4F6EF7;
                    background: #ffffff;
                }

            .filter-bar .search-box i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: #9CA3AF;
            }

        .filter-bar .category-filter select {
            padding: 0.5rem 1rem;
            border: 0.5px solid #E5E7EB;
            border-radius: 8px;
            font-size: 14px;
            background: #F9FAFB;
            color: #1A1A2E;
            min-width: 140px;
            cursor: pointer;
        }

    .badge-admin {
        background: #FCEBEB;
        color: #A32D2D;
    }

    .badge-trainer {
        background: #E6F1FB;
        color: #185FA5;
    }

    .badge-member {
        background: #EAF3DE;
        color: #3B6D11;
    }

    .table-action {
        display: flex;
        gap: 5px;
    }

        .table-action .btn {
            padding: 0.2rem 0.5rem;
            font-size: 13px;
        }

    .sort-link {
        color: #6B7280;
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .sort-link:hover {
            color: #1A1A2E;
        }

        .sort-link.active {
            color: #4F6EF7;
        }

    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .pagination-info {
        font-size: 14px;
        color: #6B7280;
    }

        .pagination-info strong {
            color: #1A1A2E;
        }

    .page-size-select {
        padding: 0.3rem 0.6rem;
        border: 0.5px solid #E5E7EB;
        border-radius: 6px;
        font-size: 13px;
        background: #F9FAFB;
    }

    .pagination {
        display: flex;
        gap: 4px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .pagination li {
            display: inline;
        }

            .pagination li a, .pagination li span {
                display: inline-block;
                padding: 0.4rem 0.8rem;
                border-radius: 6px;
                font-size: 14px;
                color: #6B7280;
                text-decoration: none;
                border: 0.5px solid transparent;
                transition: all 0.2s;
                min-width: 36px;
                text-align: center;
            }

                .pagination li a:hover {
                    background: #F9FAFB;
                    border-color: #E5E7EB;
                    color: #1A1A2E;
                }

            .pagination li.active a {
                background: #4F6EF7;
                color: white;
                border-color: #4F6EF7;
            }

            .pagination li.disabled span {
                color: #D1D5DB;
                cursor: not-allowed;
            }
</style>

<div class="container mt-4">
    <!-- Page Header -->
    <div class="page-header">
        <h2><i class="fas fa-users me-2"></i>Manage Users</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-user-plus me-2"></i>Create User
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Bar -->
    <div class="filter-bar">
        <form method="get" class="d-flex gap-2 flex-wrap align-items-center w-100">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" name="search" placeholder="Search by name, email, phone..." value="@Model.SearchTerm" />
            </div>
            <select name="role" class="category-filter">
                <option value="">All Roles</option>
                <option value="Admin" selected="@(Model.SelectedRole == "Admin")">Admin</option>
                <option value="Trainer" selected="@(Model.SelectedRole == "Trainer")">Trainer</option>
                <option value="Member" selected="@(Model.SelectedRole == "Member")">Member</option>
            </select>
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="fas fa-search me-1"></i>Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-undo me-1"></i>Clear
            </a>
            <span class="ms-auto text-muted small">
                <strong>@Model.TotalCount</strong> users found
            </span>
        </form>
    </div>

    <!-- User Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a asp-action="Index" asp-route-sortBy="id" asp-route-sortOrder="@(Model.SortBy == "id" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-search="@Model.SearchTerm" asp-route-role="@Model.SelectedRole" asp-route-page="@Model.CurrentPage" asp-route-pageSize="@Model.PageSize"
                                   class="sort-link @(Model.SortBy == "id" ? "active" : "")">
                                    ID
                                    @if (Model.SortBy == "id")
                                    {
                                        <i class="fas fa-chevron-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-sortBy="fullname" asp-route-sortOrder="@(Model.SortBy == "fullname" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-search="@Model.SearchTerm" asp-route-role="@Model.SelectedRole" asp-route-page="@Model.CurrentPage" asp-route-pageSize="@Model.PageSize"
                                   class="sort-link @(Model.SortBy == "fullname" ? "active" : "")">
                                    Full Name
                                    @if (Model.SortBy == "fullname")
                                    {
                                        <i class="fas fa-chevron-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-sortBy="email" asp-route-sortOrder="@(Model.SortBy == "email" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-search="@Model.SearchTerm" asp-route-role="@Model.SelectedRole" asp-route-page="@Model.CurrentPage" asp-route-pageSize="@Model.PageSize"
                                   class="sort-link @(Model.SortBy == "email" ? "active" : "")">
                                    Email
                                    @if (Model.SortBy == "email")
                                    {
                                        <i class="fas fa-chevron-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-sortBy="role" asp-route-sortOrder="@(Model.SortBy == "role" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-search="@Model.SearchTerm" asp-route-role="@Model.SelectedRole" asp-route-page="@Model.CurrentPage" asp-route-pageSize="@Model.PageSize"
                                   class="sort-link @(Model.SortBy == "role" ? "active" : "")">
                                    Role
                                    @if (Model.SortBy == "role")
                                    {
                                        <i class="fas fa-chevron-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>Current Plan</th>
                            <th>Phone</th>
                            <th>
                                <a asp-action="Index" asp-route-sortBy="lastlogin" asp-route-sortOrder="@(Model.SortBy == "lastlogin" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-search="@Model.SearchTerm" asp-route-role="@Model.SelectedRole" asp-route-page="@Model.CurrentPage" asp-route-pageSize="@Model.PageSize"
                                   class="sort-link @(Model.SortBy == "lastlogin" ? "active" : "")">
                                    Last Login
                                    @if (Model.SortBy == "lastlogin")
                                    {
                                        <i class="fas fa-chevron-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            var currentSubscription = user.Subscriptions?.FirstOrDefault(s => s.Status == "Active");
                            var planName = currentSubscription?.Plan?.PlanName ?? "None";

                            <tr>
                                <td>@user.UserId</td>
                                <td><i class="fas fa-user-circle me-1"></i>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge @(user.Role == "Admin" ? "badge-admin" : user.Role == "Trainer" ? "badge-trainer" : "badge-member")">
                                        @user.Role
                                    </span>
                                </td>
                                <td>
                                    @if (currentSubscription != null)
                                    {
                                        <span class="badge bg-primary">@planName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                </td>
                                <td>@(user.Phone ?? "-")</td>
                                <td>@(user.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "Never")</td>
                                <td>
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge bg-danger">🔒 Locked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">✅ Active</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-action">
                                        <a asp-action="Details" asp-route-id="@user.UserId" class="btn btn-sm btn-info" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" title="Delete"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                data-id="@user.UserId" data-name="@user.FullName">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Users.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No users found.</p>
                </div>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container">
            <div class="pagination-info">
                Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> -
                <strong>@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong>
                of <strong>@Model.TotalCount</strong> users
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small mb-0">Rows:</label>
                    <select class="page-size-select" onchange="window.location.href=updatePageSize(this.value)">
                        <option value="5" selected="@(Model.PageSize == 5)">5</option>
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                    </select>
                </div>

                <ul class="pagination">
                    <!-- Previous -->
                    <li class="@(Model.CurrentPage <= 1 ? "disabled" : "")">
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-action="Index" asp-route-search="@Model.SearchTerm" asp-route-role="@Model.SelectedRole"
                               asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder"
                               asp-route-page="@(Model.CurrentPage - 1)" asp-route-pageSize="@Model.PageSize">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        }
                        else
                        {
                            <span><i class="fas fa-chevron-left"></i></span>
                        }
                    </li>

                    <!-- Page Numbers -->
                    @{
                        var startPage = Math.Max(1, Model.CurrentPage - 2);
                        var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                        if (startPage > 1)
                        {
                            <li>
                                <a asp-action="Index" asp-route-search="@Model.SearchTerm" asp-route-role="@Model.SelectedRole"
                                   asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-page="1" asp-route-pageSize="@Model.PageSize">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="disabled"><span>...</span></li>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="@(i == Model.CurrentPage ? "active" : "")">
                                <a asp-action="Index" asp-route-search="@Model.SearchTerm" asp-route-role="@Model.SelectedRole"
                                   asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                            </li>
                        }

                        if (endPage < Model.TotalPages)
                        {
                            if (endPage < Model.TotalPages - 1)
                            {
                                <li class="disabled"><span>...</span></li>
                            }
                            <li>
                                <a asp-action="Index" asp-route-search="@Model.SearchTerm" asp-route-role="@Model.SelectedRole"
                                   asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-page="@Model.TotalPages" asp-route-pageSize="@Model.PageSize">@Model.TotalPages</a>
                            </li>
                        }
                    }

                    <!-- Next -->
                    <li class="@(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-action="Index" asp-route-search="@Model.SearchTerm" asp-route-role="@Model.SelectedRole"
                               asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder"
                               asp-route-page="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        }
                        else
                        {
                            <span><i class="fas fa-chevron-right"></i></span>
                        }
                    </li>
                </ul>
            </div>
        </div>
    }

    <script>
            function updatePageSize(size) {
                var url = new URL(window.location.href);
                url.searchParams.set('pageSize', size);
                url.searchParams.set('page', 1);
                return url.toString();
            }
    </script>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete user <strong id="deleteUserName"></strong>?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteUserId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function(event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            document.getElementById('deleteUserId').value = id;
            document.getElementById('deleteUserName').textContent = name;
        });
    </script>
}